---
import { ArrowLeft, ArrowUpRight, FileText, MessageCircle, ShieldCheck } from "lucide-astro";
import { WA_NUMBER_DISPLAY, waLink } from "../data/config";
import BaseLayout from "../layouts/BaseLayout.astro";

const topics = [
  { id: "ketentuan", label: "Ketentuan Layanan", icon: FileText },
  { id: "privasi", label: "Kebijakan Privasi", icon: ShieldCheck },
  { id: "kontak", label: "Kontak Privasi", icon: MessageCircle },
];

const contactHref = waLink("Halo Aditya, saya mau menghubungi Anda soal kebijakan privasi AsuransiSerpong.");
---

<BaseLayout
  title="Ketentuan Layanan & Kebijakan Privasi | AsuransiSerpong"
  description="Ketahui cara kerja layanan AsuransiSerpong, bagaimana data dari konsultasi WhatsApp digunakan, dan cara meminta akses, koreksi, atau penghapusan data."
  showStickyBar={false}
  showHeaderContact={false}
>
  <header class="relative isolate overflow-hidden bg-ink px-5 pt-10 pb-12 text-white md:pt-14 md:pb-16">
    <div aria-hidden="true" class="rain pointer-events-none -z-10 opacity-35"></div>
    <div class="mx-auto max-w-5xl">
      <a href="/" class="type-body-sm inline-flex min-h-11 items-center gap-2 font-semibold text-white/80 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-wa">
        <ArrowLeft aria-hidden="true" class="h-4 w-4" />
        Kembali ke beranda
      </a>
      <p class="type-eyebrow mt-6 text-wa">Informasi situs</p>
      <h1 class="type-hero mt-3 max-w-3xl">
        Ketentuan Layanan &amp; Kebijakan Privasi
      </h1>
      <p class="type-lead mt-4 max-w-xl text-white/75">
        Cara kerja konsultasi AsuransiSerpong, data yang diperlukan saat Anda menghubungi Aditya, dan cara mengajukan permintaan terkait data Anda.
      </p>
    </div>
  </header>

  <div class="mx-auto grid max-w-5xl gap-6 px-5 py-8 md:grid-cols-[14rem_minmax(0,1fr)] md:gap-8 md:py-12">
    <nav aria-label="Daftar isi" class="h-fit rounded-2xl border border-line bg-white p-3 md:sticky md:top-24">
      <p class="type-eyebrow px-3 pt-2 pb-1 text-muted">Di halaman ini</p>
      <ul>
        {topics.map(({ id, label, icon: Icon }) => (
          <li>
            <a href={`#${id}`} class="type-body-sm flex min-h-11 items-center gap-2.5 rounded-xl px-3 font-semibold hover:bg-paper focus-visible:outline-2 focus-visible:outline-wa-deep">
              <Icon aria-hidden="true" class="h-4 w-4 shrink-0 text-wa-deep" />
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="grid gap-5">
      <section id="ketentuan" aria-labelledby="ketentuan-title" class="legal-section">
        <h2 id="ketentuan-title">Ketentuan Layanan</h2>

        <h3>Siapa yang mengelola situs ini?</h3>
        <p>AsuransiSerpong.com adalah situs pribadi Aditya, Mitra Pemasar PT Mitra Jasa Pratama (Qoala). Situs ini bukan situs resmi Qoala, PT Mitra Jasa Pratama, atau perusahaan asuransi penerbit polis.</p>

        <h3>Apa yang bisa dibantu Aditya?</h3>
        <p>Aditya dapat membantu menjelaskan isi polis, menyiapkan penawaran dari rekanan yang tersedia, serta mendampingi pengajuan dan klaim. Artikel dan contoh di situs ini bersifat informatif. Ringkasan di situs atau penjelasan lewat chat tidak menggantikan dokumen polis resmi.</p>

        <h3>Siapa yang menentukan pertanggungan dan klaim?</h3>
        <p>Meminta penawaran atau mengirim dokumen tidak otomatis membuat Anda tertanggung. Perusahaan asuransi menentukan persetujuan pengajuan, premi final, dan keputusan klaim. Manfaat, pengecualian, biaya sendiri, masa berlaku, dan tenggat pelaporan mengikuti polis resmi. Untuk melapor klaim atau meminta bantuan darurat, gunakan kanal resmi perusahaan asuransi yang tercantum di polis.</p>

        <h3>Bagaimana cara membayar?</h3>
        <p>Jika Anda memutuskan melanjutkan, bayar hanya melalui tautan atau kanal pembayaran resmi perusahaan asuransi. Jangan transfer ke rekening pribadi Aditya atau pihak lain yang mengatasnamakan AsuransiSerpong. Pastikan informasi yang Anda berikan untuk pengajuan benar dan bahwa Anda berhak membagikan dokumennya.</p>
      </section>

      <section id="privasi" aria-labelledby="privasi-title" class="legal-section">
        <h2 id="privasi-title">Kebijakan Privasi</h2>
        <p>Kebijakan ini mencakup kunjungan ke AsuransiSerpong.com dan komunikasi Anda dengan Aditya untuk keperluan konsultasi atau bantuan asuransi.</p>

        <h3>Data yang diterima dan kegunaannya</h3>
        <p>Situs ini tidak menyediakan akun, formulir pengajuan, atau unggahan dokumen. Jika Anda mengirim pesan lewat WhatsApp, Aditya dapat menerima nama, nomor WhatsApp, isi pesan, dan dokumen yang Anda pilih untuk dikirim. Data tersebut digunakan untuk menjawab pertanyaan, membaca polis, menyiapkan penawaran, menindaklanjuti permintaan, atau membantu pengajuan dan klaim yang Anda minta.</p>
        <p class="rounded-xl bg-wa-soft p-4 text-ink"><strong>Untuk konsultasi awal, kirim seperlunya.</strong> Jika mengirim foto polis, tutupi informasi yang tidak relevan. Jangan kirim PIN, kode OTP, kata sandi, atau detail kartu pembayaran. Kirim dokumen identitas hanya jika memang diperlukan untuk proses yang Anda setujui, melalui kanal yang telah Anda verifikasi.</p>

        <h3>Kapan data dibagikan?</h3>
        <p>Data Anda tidak dijual. Jika Anda meminta untuk melanjutkan proses, data yang diperlukan dapat diteruskan kepada PT Mitra Jasa Pratama (Qoala) atau perusahaan asuransi terkait. Data juga dapat diungkapkan jika diwajibkan oleh hukum. Pengolahan data oleh pihak penerima mengikuti kebijakan privasi dan kewajiban masing-masing.</p>

        <h3>Layanan pihak ketiga dan data teknis</h3>
        <p>Kami menggunakan Google Analytics dan Microsoft Clarity untuk memahami kunjungan dan meningkatkan situs. Layanan tersebut dapat memproses data penggunaan seperti halaman yang dibuka, sumber kunjungan, jenis browser dan perangkat, perkiraan lokasi, serta interaksi di halaman. Layanan dapat menggunakan cookie atau teknologi serupa sesuai konfigurasi dan kebijakan masing-masing.</p>
        <p>Microsoft Clarity merekam interaksi sesi, seperti klik dan guliran, serta membuat peta panas untuk membantu memahami penggunaan halaman. Kami mengatur perlindungan untuk menyamarkan informasi sensitif yang mungkin tertangkap. Hindari memasukkan informasi sensitif ke halaman situs. Baca juga <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer" class="font-semibold text-wa-deep underline underline-offset-4">Kebijakan Privasi Google</a> dan <a href="https://privacy.microsoft.com/privacystatement" target="_blank" rel="noopener noreferrer" class="font-semibold text-wa-deep underline underline-offset-4">Pernyataan Privasi Microsoft</a>.</p>
        <p>Penyedia hosting dapat mencatat data teknis, seperti alamat IP dan waktu permintaan. Situs juga memuat huruf dari Google Fonts, sehingga browser Anda menghubungi server Google.</p>
        <p>Saat pop-up kontak dibuka di desktop, layanan QR Server menerima tautan WhatsApp tujuan dan teks pembuka bawaan situs untuk membuat kode QR. Isi chat dan lampiran tidak dikirim ke layanan QR itu. Saat Anda membuka WhatsApp, pemrosesan oleh WhatsApp mengikuti kebijakan privasinya sendiri.</p>

        <h3>Penyimpanan dan permintaan terkait data</h3>
        <p>Data disimpan selama masih diperlukan untuk menangani permintaan Anda atau memenuhi kewajiban hukum. Anda dapat meminta akses, koreksi, atau penghapusan data, serta menarik persetujuan jika pemrosesan didasarkan pada persetujuan, melalui <a href="#kontak" class="font-semibold text-wa-deep underline underline-offset-4">kontak privasi</a>. Aditya dapat meminta verifikasi sebelum memproses permintaan. Jika data sudah diteruskan, permintaan atas salinan yang disimpan pihak lain mungkin perlu disampaikan langsung kepada pihak tersebut.</p>

        <h3>Pembaruan kebijakan</h3>
        <p>Jika ketentuan layanan atau praktik pengolahan data berubah, versi terbaru akan ditampilkan di halaman ini.</p>
      </section>

      <section id="kontak" aria-labelledby="kontak-title" class="rounded-3xl bg-ink p-5 text-white sm:p-7">
        <h2 id="kontak-title" class="type-panel-title">Kontak Privasi</h2>
        <p class="type-body-sm mt-2 max-w-xl text-white/75">Untuk bertanya atau meminta penghapusan data, hubungi Aditya. Cukup tulis &ldquo;hapus data&rdquo; dan jelaskan permintaan Anda tanpa menyertakan dokumen sensitif di pesan pertama.</p>
        <a href={contactHref} target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex min-h-11 flex-wrap items-center gap-x-2 rounded-sm font-semibold text-wa underline underline-offset-4 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-wa">
          WhatsApp Aditya: {WA_NUMBER_DISPLAY}
          <ArrowUpRight aria-hidden="true" class="h-4 w-4" />
        </a>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  @reference "../styles/global.css";

  .legal-section {
    @apply rounded-3xl border border-line bg-white p-5 sm:p-7 md:p-8;
  }

  .legal-section h2 {
    @apply font-display font-extrabold;
    font-size: 1.5rem;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .legal-section h3 {
    @apply mt-6 font-display font-bold;
    font-size: 1.25rem;
    line-height: 1.4;
    letter-spacing: -0.015em;
  }

  .legal-section p {
    @apply mt-2 text-muted;
    font-size: 1.0625rem;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }

  .legal-section p.bg-wa-soft {
    @apply mt-4 text-ink;
  }

  section[id] {
    scroll-margin-top: 5.5rem;
  }
</style>
