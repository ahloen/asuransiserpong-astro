---
import BaseLayout from "../layouts/BaseLayout.astro";
import WaButton from "../components/WaButton.astro";
import { ArrowRight, ArrowUpRight, Check, ChevronDown, Phone, ShieldAlert, Smartphone, Truck, Wrench } from "lucide-astro";

const claimMessage = "Halo Aditya, kondisi saya sudah aman. Mohon panduan dokumen dan langkah pelaporan klaim Zurich.";
const zurichWhatsApp = "https://wa.me/628121113456";

const safetySteps = [
  {
    title: "Utamakan keselamatan",
    text: "Nyalakan lampu hazard jika aman. Jauhkan diri dan penumpang dari arus lalu lintas; jangan mengambil risiko demi memotret kendaraan.",
  },
  {
    title: "Telepon Zurich Care",
    text: "Jelaskan kondisi kendaraan, lokasi atau patokan KM tol, arah perjalanan, dan apakah mobil masih bisa dijalankan.",
  },
  {
    title: "Dokumentasikan setelah aman",
    text: "Jika situasi sudah terkendali, foto kerusakan dan lokasi untuk membantu pelaporan. Ikuti arahan Zurich sebelum memindahkan atau memperbaiki kendaraan.",
  },
];

const roadServices = [
  {
    title: "Mobil derek",
    text: "Tanyakan ketersediaan derek bila mobil tidak dapat dijalankan setelah insiden. Minta arahan Zurich sebelum memesan derek sendiri.",
    icon: Truck,
  },
  {
    title: "Bantuan gangguan ringan",
    text: "Untuk kendala ringan di jalan, tanyakan apakah bantuan perbaikan di lokasi tersedia di area Anda dan tercakup dalam polis.",
    icon: Wrench,
  },
  {
    title: "Bantuan terkait ambulans",
    text: "Jika ada orang yang terluka, utamakan bantuan medis. Hubungi Zurich untuk menanyakan fasilitas atau penggantian biaya sesuai polis.",
    icon: ShieldAlert,
  },
];

const claimDocuments = [
  "Kronologi kejadian",
  "Identitas pelapor dan pengemudi",
  "SIM pengemudi saat kejadian",
  "STNK kendaraan",
  "Polis atau sertifikat beserta lampiran",
  "Foto kerusakan kendaraan",
];
---

<BaseLayout
  title="Nomor Darurat Zurich Autocillin 24 Jam | AsuransiSerpong"
  description="Butuh bantuan Zurich Autocillin di jalan? Hubungi Zurich Care 24 jam. Lihat langkah aman setelah insiden, opsi bantuan, dan panduan klaim."
  showStickyBar={false}
  showHeaderContact={false}
>
  <article class="overflow-hidden bg-paper">
    <section class="relative isolate overflow-hidden bg-ink px-5 pt-7 pb-9 text-white md:py-14" aria-labelledby="zurich-title">
      <div aria-hidden="true" class="rain pointer-events-none -z-10 opacity-25"></div>
      <div class="mx-auto grid max-w-5xl items-center gap-6 md:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)] md:gap-8 lg:gap-14">
        <div>
          <p class="text-xs font-bold tracking-[0.12em] text-[#b8e8cd] uppercase">Nomor darurat Zurich Autocillin</p>
          <h1 id="zurich-title" class="mt-3 max-w-xl font-display text-[clamp(1.875rem,5vw,3.5rem)] leading-[1.12] font-extrabold tracking-[-0.04em]">
            Kecelakaan atau kendala di jalan?
          </h1>
          <p class="mt-4 max-w-xl text-sm leading-relaxed text-white/85 md:text-base">Bantuan darurat Zurich Autocillin tersedia 24 jam. Telepon Zurich Care di 1500 456 dan sampaikan lokasi serta kondisi kendaraan.</p>
          <p class="mt-4 flex items-start gap-2.5 border-l-2 border-[#f5c45e] pl-3 text-sm leading-relaxed text-white/85 md:mt-6 md:text-base">
            <ShieldAlert aria-hidden="true" class="mt-0.5 h-5 w-5 shrink-0 text-[#f5c45e]" />
            <span>Jika ada korban atau bahaya langsung, hubungi layanan darurat setempat lebih dulu. <strong class="text-white">Jangan menunggu balasan WhatsApp.</strong></span>
          </p>
        </div>

        <div class="rounded-3xl bg-white p-4 text-ink shadow-xl shadow-black/20 sm:p-5 md:p-6">
          <h2 class="px-1 text-xs font-bold tracking-[0.1em] text-muted uppercase">Zurich Care · Hotline 24 jam</h2>
          <a
            href="tel:1500456"
            class="mt-2.5 flex w-full items-center gap-3 rounded-2xl bg-wa px-4 py-3 text-wa-ink transition hover:bg-[#2fe074] focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-sky-400"
          >
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-wa-ink/10" aria-hidden="true"><Phone class="h-5 w-5" /></span>
            <span>
              <span class="block text-xs font-bold">Telepon Zurich</span>
              <span class="block font-display text-[clamp(1.625rem,4vw,2.25rem)] leading-none font-extrabold whitespace-nowrap tabular-nums">1500 456</span>
            </span>
          </a>
          <p class="mt-2.5 px-1 text-sm leading-relaxed text-muted">Telepon untuk meminta bantuan di jalan.</p>
          <div class="mt-3 flex flex-wrap items-center justify-between gap-x-3 border-t border-line px-1 pt-1">
            <a href={zurichWhatsApp} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 flex-col justify-center text-sm font-bold text-wa-deep focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-400">
              <span class="inline-flex items-center gap-1 underline decoration-wa-deep/40 underline-offset-4 hover:decoration-current">WhatsApp Zurich Care <ArrowUpRight aria-hidden="true" class="h-3.5 w-3.5" /></span>
              <span class="text-xs font-medium text-muted tabular-nums">0812 111 3456</span>
            </a>
            <span class="text-xs text-muted">Chat, bukan layanan darurat</span>
          </div>
        </div>
      </div>
    </section>

    <section class="px-5 py-10 md:py-14" aria-labelledby="zurich-steps">
      <div class="mx-auto max-w-5xl">
        <h2 id="zurich-steps" class="font-display text-[1.75rem] leading-tight font-extrabold tracking-[-0.03em] md:text-4xl">Yang perlu dilakukan di lokasi</h2>
        <ol class="mt-5 grid gap-3 md:grid-cols-3">
          {safetySteps.map(({ title, text }, index) => (
            <li class="flex items-start gap-3 rounded-2xl border border-line bg-white p-4 md:flex-col md:p-5">
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-wa-soft font-display text-sm font-extrabold text-wa-deep" aria-hidden="true">{index + 1}</span>
              <div>
                <h3 class="font-display text-base font-bold">{title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-muted">{text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="border-y border-line bg-white px-5 py-12 md:py-16">
      <div class="mx-auto max-w-5xl">
        <div class="max-w-2xl">
          <p class="text-[0.75rem] font-bold tracking-[0.14em] text-wa-deep uppercase">Autocillin Rescue</p>
          <h2 class="mt-2 font-display text-[1.8rem] leading-[1.15] font-extrabold tracking-[-0.035em] md:text-[2.35rem]">Opsi bantuan Zurich yang bisa ditanyakan</h2>
          <p class="mt-3 text-[0.9375rem] leading-[1.7] text-muted">Sebutkan lokasi dan kondisi Anda saat menelepon. Zurich akan mengonfirmasi ketersediaan layanan, manfaat, serta ketentuan yang berlaku untuk polis dan wilayah Anda.</p>
        </div>
        <div class="mt-6 grid gap-3 md:grid-cols-3">
          {roadServices.map((service) => {
            const Icon = service.icon;
            return (
              <article class="rounded-3xl border border-line bg-paper p-5 md:p-6">
                <span class="grid h-11 w-11 place-items-center rounded-2xl bg-white text-wa-deep"><Icon class="h-5 w-5" /></span>
                <h3 class="mt-4 font-display text-[1.0625rem] font-bold">{service.title}</h3>
                <p class="mt-2 text-[0.8125rem] leading-[1.7] text-muted">{service.text}</p>
              </article>
            );
          })}
        </div>

        <div class="mt-4 grid gap-3 md:grid-cols-2">
          <article class="flex gap-3 rounded-2xl border border-line bg-paper p-4 md:p-5">
            <Smartphone class="mt-0.5 h-5 w-5 shrink-0 text-wa-deep" />
            <div>
              <h3 class="font-display text-[0.9375rem] font-bold">Pelaporan klaim secara online</h3>
              <p class="mt-1 text-[0.8125rem] leading-[1.65] text-muted">Tanyakan kanal pelaporan digital Zurich untuk mengirim informasi kejadian dan foto kerusakan serta memantau tindak lanjut.</p>
            </div>
          </article>
          <article class="flex gap-3 rounded-2xl border border-line bg-paper p-4 md:p-5">
            <Wrench class="mt-0.5 h-5 w-5 shrink-0 text-wa-deep" />
            <div>
              <h3 class="font-display text-[0.9375rem] font-bold">Bengkel rekanan</h3>
              <p class="mt-1 text-[0.8125rem] leading-[1.65] text-muted">
                <a
                  href="https://www.zurich.co.id/-/media-assets/project/zurich-headless/indonesia/docs/rekanan/list/daftar-bengkel-rekanan-utama-zurich-autocillin-garage.pdf"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-bold text-wa-deep underline decoration-wa-deep/30 underline-offset-2 hover:decoration-wa-deep"
                >
                  Daftar bengkel rekanan utama Zurich Autocillin Garage (PDF resmi)
                </a>
                <span class="block mt-1">Diperbarui 4 Mei 2026. Daftar dapat berubah; konfirmasikan ke Zurich bahwa bengkel sesuai dengan polis Anda sebelum datang atau memulai perbaikan. Dokumen diterbitkan PT Zurich Asuransi Indonesia Tbk.</span>
              </p>
            </div>
          </article>
        </div>
        <p class="mt-4 text-[0.75rem] leading-[1.6] text-muted">Informasi di atas bersifat panduan umum, bukan jaminan manfaat. Cakupan, limit, prosedur, dan persetujuan klaim mengikuti polis serta keputusan Zurich.</p>
      </div>
    </section>

    <section class="px-5 py-10 md:py-14" aria-labelledby="zurich-claims">
      <div class="mx-auto grid max-w-5xl items-start gap-6 md:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] lg:gap-12">
        <div>
          <p class="text-xs font-bold tracking-[0.12em] text-wa-deep uppercase">Setelah keadaan aman</p>
          <h2 id="zurich-claims" class="mt-2 font-display text-[1.75rem] leading-tight font-extrabold tracking-[-0.03em] md:text-4xl">Pelaporan dan dokumen klaim</h2>
          <p class="mt-3 text-sm leading-relaxed text-muted">Laporkan kejadian ke Zurich sesegera mungkin melalui Zurich Care atau kanal pelaporan yang dikonfirmasi Zurich. Batas waktu, formulir, dan persyaratan mengikuti polis serta arahan Zurich.</p>

          <h3 class="mt-5 font-display text-base font-bold">Informasi awal yang sebaiknya disiapkan</h3>
          <ul class="mt-3 grid gap-x-4 gap-y-2 rounded-2xl border border-line bg-white p-4 sm:grid-cols-2">
            {claimDocuments.map((document) => (
              <li class="flex gap-2 text-sm leading-relaxed text-muted">
                <Check aria-hidden="true" class="mt-0.5 h-4 w-4 shrink-0 text-wa-deep" />
                <span>{document}</span>
              </li>
            ))}
          </ul>

          <div class="mt-4 rounded-2xl border border-[#f5c45e]/50 bg-[#fff8e8] p-4">
            <h3 class="font-display text-base font-bold">Jika melibatkan pihak ketiga</h3>
            <p class="mt-1 text-sm leading-relaxed text-muted">Sampaikan hal ini saat melapor dan tanyakan kepada Zurich apakah laporan polisi atau dokumen tambahan diperlukan sebelum membuat kesepakatan atau memberikan ganti rugi.</p>
          </div>
        </div>

        <aside class="rounded-3xl bg-ink p-5 text-white md:p-6" aria-labelledby="zurich-claim-help">
          <p class="text-xs font-bold tracking-[0.12em] text-[#b8e8cd] uppercase">AsuransiSerpong</p>
          <h3 id="zurich-claim-help" class="mt-2 font-display text-xl font-bold">Bantuan klaim online</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/80">Saya bisa bantu memahami kelengkapan berkas dan langkah pelaporan, serta mencari informasi bengkel rekanan. Mulai dari kronologi singkat; jangan kirim dokumen sensitif sebelum diminta dan pastikan kanal pengirimannya terverifikasi.</p>
          <WaButton message={claimMessage} class="mt-4 w-full">Chat Aditya</WaButton>
          <p class="mt-3 text-xs leading-relaxed text-white/70">Jam pendampingan administrasi: Senin–Jumat 08.00–18.00, Sabtu 08.00–14.00 WIB. WhatsApp ini tidak dipantau 24 jam.</p>
          <p class="mt-3 border-t border-white/15 pt-3 text-xs leading-relaxed text-white/75">Pendampingan hanya online, bukan bantuan darurat atau pengurusan laporan polisi. Bantuan di lokasi, keputusan klaim, dan nilai ganti rugi ditetapkan Zurich.</p>
        </aside>
      </div>
    </section>

    <section class="border-t border-line bg-white px-5 py-7 md:py-8" aria-labelledby="zurich-contacts">
      <div class="mx-auto max-w-5xl">
        <details class="group rounded-2xl border border-line bg-paper px-4 py-3.5 md:px-5">
          <summary id="zurich-contacts" class="flex min-h-8 cursor-pointer list-none items-center justify-between gap-4 font-display text-[0.9375rem] font-bold marker:hidden [&::-webkit-details-marker]:hidden">
            Kontak resmi Zurich
            <ChevronDown class="h-5 w-5 shrink-0 text-muted transition group-open:rotate-180" />
          </summary>
          <div class="flex flex-wrap gap-x-6 pt-2 text-sm font-bold text-wa-deep">
            <a class="inline-flex min-h-11 items-center gap-1.5 underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-400" href="tel:1500456"><Phone aria-hidden="true" class="h-4 w-4" /> Hotline 24 jam · 1500 456</a>
            <a class="inline-flex min-h-11 items-center gap-1.5 underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-400" href="https://www.zurich.co.id" target="_blank" rel="noopener noreferrer">Situs resmi Zurich <ArrowUpRight aria-hidden="true" class="h-4 w-4" /></a>
          </div>
          <p class="border-t border-line pt-3 text-xs leading-relaxed text-muted">Untuk info terbaru, periksa situs resmi Zurich atau nomor yang tercantum pada polis Anda.</p>
        </details>
      </div>
    </section>

    <section class="px-5 py-12 md:py-16">
      <div class="mx-auto flex max-w-5xl flex-col gap-5 rounded-3xl bg-[#e8f2eb] p-6 md:flex-row md:items-center md:justify-between md:p-8">
        <div class="max-w-2xl">
          <p class="text-[0.75rem] font-bold tracking-[0.14em] text-wa-deep uppercase">Untuk nanti, saat polis mau habis</p>
          <h2 class="mt-2 font-display text-[1.5rem] leading-[1.2] font-extrabold tracking-[-0.03em] md:text-[1.8rem]">Cek isi polis sebelum memutuskan perpanjangan.</h2>
          <p class="mt-2 text-[0.875rem] leading-[1.65] text-muted">Pelajari hal yang perlu dicek: perlindungan banjir, biaya sendiri, dan pilihan bengkel.</p>
        </div>
        <a href="/asuransi-mobil" class="inline-flex min-h-12 shrink-0 items-center justify-center gap-2 rounded-xl bg-ink px-5 text-[0.875rem] font-bold text-white transition hover:bg-[#183149] focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-sky-400">
          Panduan asuransi mobil
          <ArrowRight class="h-4 w-4" />
        </a>
      </div>
      <p class="mx-auto mt-5 max-w-5xl text-[0.6875rem] leading-[1.6] text-muted">AsuransiSerpong adalah website pribadi Aditya, bukan website resmi Zurich. Informasi manfaat yang berlaku mengacu pada dokumen polis resmi.</p>
    </section>
  </article>
</BaseLayout>
