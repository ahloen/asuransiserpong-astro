---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { ArrowLeft, ArrowRight, ArrowUpRight, Check, ChevronRight, Clock, ListOrdered, MessageCircle, ShieldCheck } from "lucide-astro";
import BlogArt from "../../components/BlogArt.astro";
import BlogCard from "../../components/BlogCard.astro";
import WaButton from "../../components/WaButton.astro";
import { blogCategories, sortBlogNewest } from "../../data/blog";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, excerpt, tldr, metaTitle, metaDescription, category, topic, date, dateModified, readTime, bullets } = post.data;
const currentCategory = blogCategories.find(({ id }) => id === category)!;
const related = await getCollection("blog", ({ id, data }) => id !== post.id && data.category === category);
related.sort(sortBlogNewest);
const message = `Halo Aditya, saya baru membaca artikel tentang ${topic ?? currentCategory.service.label} dan mau bertanya soal ${currentCategory.service.label.toLowerCase()}.`;
const faqSection = (post.body ?? "").split(/^## Pertanyaan yang sering muncul\s*$/m)[1]?.split(/^## /m)[0] ?? "";
const articleFaqs = faqSection
  .split(/(?=^### )/m)
  .map((block) => {
    const match = block.trim().match(/^### (.+)\s*\n+([\s\S]*)$/);
    if (!match) return undefined;
    const answer = match[2]
      .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
      .replace(/[*_`]/g, "")
      .replace(/\s+/g, " ")
      .trim();
    return answer ? { question: match[1].trim(), answer } : undefined;
  })
  .filter((faq): faq is { question: string; answer: string } => Boolean(faq));
// Daftar isi editorial: hanya H2, kecuali H2 FAQ / penutup CTA
const toc = headings.filter(
  (h) => h.depth === 2 && !/pertanyaan yang sering muncul|bingung memilih|cek polis sebelum|sebelum berangkat|tanyakan alur|setelah lima hal/i.test(h.text),
);
const tldrPoints = tldr
  .split(/(?<=[.!?])\s+(?=[A-Z0-9"“])/)
  .map((s) => s.trim())
  .filter(Boolean);
const shareText = `${title} — via AsuransiSerpong`;
const shareUrl = `/blog/${post.id}`;
---

<BaseLayout
  title={metaTitle ?? `${title} | AsuransiSerpong`}
  description={metaDescription ?? excerpt}
  stickyMessage={message}
  schemaType="article"
  article={{ headline: title, datePublished: date, dateModified, description: excerpt }}
  faqs={articleFaqs}
>
  <div id="read-progress" aria-hidden="true"></div>

  <article>
    {/* ===== HERO EDITORIAL ===== */}
    <header class="border-b border-line bg-[#eeeee4]">
      <div class="mx-auto max-w-5xl px-5 pt-6 pb-9 md:pb-12">
        <nav aria-label="Jejak navigasi" class="type-fine flex flex-wrap items-center gap-2 font-bold text-muted">
          <a href="/" class="hover:text-ink hover:underline">Beranda</a>
          <ChevronRight class="size-3.5" aria-hidden="true" />
          <a href="/blog" class="hover:text-ink hover:underline">Artikel</a>
          <ChevronRight class="size-3.5" aria-hidden="true" />
          <a href={currentCategory.href} class="text-wa-deep hover:underline">{currentCategory.label}</a>
        </nav>

        <div class="mt-6 max-w-3xl md:mt-8">
          <p class="type-eyebrow flex flex-wrap items-center gap-2 text-wa-deep">
            <span class="inline-flex items-center rounded-full bg-ink px-3 py-1 text-[0.7rem] tracking-[0.12em] text-white uppercase">{currentCategory.service.label}</span>
            {topic && <span class="font-bold text-ink/70 normal-case tracking-normal">/ {topic}</span>}
          </p>
          <h1 class="type-hero mt-4 text-balance">{title}</h1>
          <p class="type-lead mt-4 max-w-prose text-muted">{excerpt}</p>

          <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
            <div class="flex items-center gap-3">
              <img src="/avatar-aditya.jpg" alt="Potret Aditya, penulis panduan asuransi di Serpong" width="44" height="44" class="size-11 shrink-0 rounded-full border border-white object-cover" />
              <div>
                <p class="type-body-sm font-extrabold">Aditya <span class="font-medium text-muted">· AsuransiSerpong</span></p>
                <p class="type-fine mt-0.5 flex flex-wrap items-center gap-x-2 gap-y-1 font-semibold text-muted">
                  <time datetime={new Date(date).toISOString().slice(0, 10)}>{date}</time>
                  <span aria-hidden="true">·</span>
                  <span class="inline-flex items-center gap-1"><Clock class="size-3.5" aria-hidden="true" /> {readTime} baca</span>
                </p>
              </div>
            </div>
            <div class="flex items-center gap-2" aria-label="Bagikan artikel">
              <a
                href={`https://wa.me/?text=${encodeURIComponent(`${shareText} ${shareUrl}`)}`}
                target="_blank" rel="noopener noreferrer"
                class="inline-flex min-h-10 items-center gap-1.5 rounded-full border border-line bg-white px-3.5 text-[0.8rem] font-bold text-ink transition hover:border-wa-deep hover:text-wa-deep"
              >
                <MessageCircle class="size-4" aria-hidden="true" /> WA
              </a>
              <button
                type="button" data-copy-link={shareUrl}
                class="inline-flex min-h-10 cursor-pointer items-center rounded-full border border-line bg-white px-3.5 text-[0.8rem] font-bold text-ink transition hover:border-wa-deep hover:text-wa-deep"
              >
                Salin tautan
              </button>
            </div>
          </div>
        </div>

        <figure class="mt-7 md:mt-9">
          <div class="aspect-video w-full overflow-hidden rounded-3xl">
            <BlogArt
              category={category}
              postId={post.id}
              sizes="(min-width: 1024px) 960px, 100vw"
              priority
              position={post.data.imagePosition ?? "center"}
            />
          </div>
          <figcaption class="type-fine mt-3 text-center font-medium text-muted">
            Ilustrasi: {topic ?? currentCategory.service.label} — panduan praktis untuk area BSD, Gading Serpong &amp; Alam Sutera.
          </figcaption>
        </figure>
      </div>
    </header>

    {/* ===== BODY: 2 KOLOM EDITORIAL ===== */}
    <div class="mx-auto max-w-5xl px-5 py-9 md:py-12">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_19rem] lg:items-start">

        {/* Kolom artikel */}
        <div class="min-w-0 max-w-[44rem]">
          {/* Ringkasan 30 detik */}
          <section aria-label="Ringkasan 30 detik" class="overflow-hidden rounded-3xl border border-line bg-white">
            <div class="flex items-center gap-2.5 border-b border-line bg-[#f4f1e8] px-5 py-3.5 sm:px-6">
              <span class="grid size-7 shrink-0 place-items-center rounded-full bg-ink text-white" aria-hidden="true"><Check class="size-4" stroke-width={3} /></span>
              <h2 class="type-card-title">Ringkasan 30 detik</h2>
            </div>
            <div class="p-5 sm:p-6">
              {tldrPoints.length > 1 ? (
                <ul class="space-y-3" role="list">
                  {tldrPoints.map((point) => (
                    <li class="type-card-body flex items-start gap-2.5 text-ink/85">
                      <span aria-hidden="true" class="mt-[0.6em] size-1.5 shrink-0 rounded-full bg-wa-deep" />
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="type-card-body text-ink/85">{tldr}</p>
              )}
              {bullets && bullets.length > 0 && (
                <div class="mt-5 rounded-2xl bg-wa-soft/60 p-4 sm:p-5">
                  <p class="type-fine font-bold tracking-wide text-wa-deep uppercase">Cek sebelum memilih</p>
                  <ul class="mt-3 space-y-2.5" role="list">
                    {bullets.map((item) => (
                      <li class="type-card-body flex items-start gap-2.5 text-ink/90">
                        <span class="grid size-5.5 shrink-0 place-items-center rounded-full bg-wa-deep text-white" aria-hidden="true"><Check class="size-3.5" stroke-width={3} /></span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </section>

          {/* Daftar isi — mobile */}
          {toc.length > 0 && (
            <details class="group mt-6 rounded-2xl border border-line bg-white lg:hidden">
              <summary class="flex cursor-pointer list-none items-center gap-2.5 px-5 py-4 font-bold [&::-webkit-details-marker]:hidden">
                <ListOrdered class="size-4.5 text-wa-deep" aria-hidden="true" />
                <span class="type-card-title">Daftar isi</span>
                <ChevronRight class="ml-auto size-4 text-muted transition group-open:rotate-90" aria-hidden="true" />
              </summary>
              <nav aria-label="Daftar isi" class="border-t border-line px-5 py-4">
                <ol class="space-y-2.5">
                  {toc.map((h, i) => (
                    <li>
                      <a href={`#${h.slug}`} class="type-body-sm flex items-baseline gap-2.5 font-semibold text-ink/80 hover:text-wa-deep hover:underline">
                        <span class="type-fine font-extrabold text-wa-deep">{String(i + 1).padStart(2, "0")}</span> {h.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            </details>
          )}

          {/* Isi artikel */}
          <section aria-label="Isi artikel" class="article-copy mt-8"><Content /></section>
          <p class="type-fine mt-8 border-t border-dashed border-line pt-4 font-medium text-muted">
            Terakhir diperbarui: {dateModified ?? date} · Ditulis untuk pemilik kendaraan &amp; rumah di BSD City, Gading Serpong, Alam Sutera.
          </p>

          {/* Konsultasi */}
          <aside aria-labelledby="consult-title" class="mt-8 rounded-3xl bg-ink p-6 text-white sm:flex sm:items-center sm:gap-6 sm:p-7">
            <div class="min-w-0 sm:flex-1">
              <ShieldCheck class="size-6 text-wa" aria-hidden="true" />
              <h2 id="consult-title" class="type-panel-title mt-3">Masih ragu soal polis Anda?</h2>
              <p class="type-card-body mt-2 text-white/75">Kirim foto ikhtisar polis (tutup data pribadi dulu). Aditya bantu tunjukkan bagian mana yang perlu dicek.</p>
            </div>
            <div class="mt-5 shrink-0 sm:mt-0 sm:w-56">
              <WaButton message={message} class="w-full px-3">Tanya Aditya</WaButton>
              <a href={currentCategory.service.href} class="type-body-sm mt-2 inline-flex min-h-11 items-center gap-1.5 font-bold text-white underline decoration-white/50 underline-offset-4 hover:decoration-white">
                Lihat {currentCategory.service.label} <ArrowUpRight class="size-4 shrink-0" aria-hidden="true" />
              </a>
            </div>
          </aside>
        </div>

        {/* Sidebar sticky — desktop (sticky harus di aside, bukan div dalam, supaya range nempelnya setinggi kolom artikel) */}
        <aside class="hidden min-w-0 self-start lg:sticky lg:top-20 lg:block">
          <div class="space-y-5">
            {toc.length > 0 && (
              <nav aria-label="Daftar isi" class="rounded-3xl border border-line bg-white p-5">
                <p class="type-fine flex items-center gap-2 font-bold tracking-wider text-muted uppercase">
                  <ListOrdered class="size-4 text-wa-deep" aria-hidden="true" /> Daftar isi
                </p>
                <ol class="mt-3 max-h-[38dvh] space-y-1 overflow-y-auto pr-1 [scrollbar-width:thin]">
                  {toc.map((h, i) => (
                    <li>
                      <a
                        href={`#${h.slug}`}
                        data-toc-link={h.slug}
                        class="type-body-sm flex items-baseline gap-2.5 rounded-xl px-2 py-1.5 font-semibold text-ink/70 transition hover:bg-[#f4f1e8] hover:text-wa-deep"
                      >
                        <span class="type-fine font-extrabold text-wa-deep">{String(i + 1).padStart(2, "0")}</span> {h.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            )}
            <div class="rounded-3xl bg-ink p-5 text-white">
              <ShieldCheck class="size-6 text-wa" aria-hidden="true" />
              <p class="type-card-title mt-2">Cek polis gratis</p>
              <p class="type-body-sm mt-1.5 text-white/70">Bingung baca ikhtisar polis? Kirim fotonya, Aditya bantu cek.</p>
              <WaButton message={message} size="md" class="mt-4 w-full">Chat Aditya</WaButton>
              <p class="type-fine mt-3 text-center text-white/50">Tanpa kewajiban membeli</p>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </article>

  <section aria-label="Bacaan selanjutnya" class="border-t border-line bg-[#eeeee4]">
    <div class="mx-auto max-w-5xl px-5 pt-8 pb-12 sm:pt-10 sm:pb-16">
      {related.length > 0 && (
        <>
          <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
            <h2 class="type-subsection">Bacaan terkait</h2>
            <a href={currentCategory.href} class="type-body-sm inline-flex min-h-11 items-center gap-1.5 font-bold text-wa-deep hover:underline">Artikel {currentCategory.label} <ArrowRight class="size-4" aria-hidden="true" /></a>
          </div>
          <div class="mt-4 grid gap-5 sm:grid-cols-2">
            {related.slice(0, 2).map((item) => <BlogCard post={item} />)}
          </div>
        </>
      )}
      <a href="/blog" class:list={["type-body-sm inline-flex min-h-11 items-center gap-1.5 font-bold text-wa-deep hover:underline", related.length > 0 && "mt-4"]}><ArrowLeft class="size-4" aria-hidden="true" /> Kembali ke semua artikel</a>
    </div>
  </section>
</BaseLayout>

<script>
  // Progress bar + toc aktif + salin tautan + FAQ accordion
  const progress = document.getElementById("read-progress");
  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")];
  const copyBtn = document.querySelector<HTMLButtonElement>("[data-copy-link]");

  function onScroll() {
    const h = document.documentElement;
    const max = h.scrollHeight - h.clientHeight;
    const p = max > 0 ? Math.min(1, Math.max(0, h.scrollTop / max)) : 0;
    if (progress) progress.style.transform = `scaleX(${p})`;
  }
  document.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  copyBtn?.addEventListener("click", async () => {
    const url = new URL(copyBtn.dataset.copyLink ?? window.location.pathname, window.location.origin).href;
    try {
      await navigator.clipboard.writeText(url);
      copyBtn.textContent = "Tautan tersalin ✓";
    } catch {
      window.prompt("Salin tautan ini:", url);
    }
    setTimeout(() => (copyBtn.textContent = "Salin tautan"), 2000);
  });

  // Tandai bab aktif di sidebar
  if (tocLinks.length > 0 && "IntersectionObserver" in window) {
    const bySlug = new Map(tocLinks.map((a) => [a.dataset.tocLink, a]));
    const obs = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const id = (e.target as HTMLElement).id;
          tocLinks.forEach((a) => a.classList.remove("!bg-[#e6ede1]", "!text-wa-deep"));
          bySlug.get(id)?.classList.add("!bg-[#e6ede1]", "!text-wa-deep");
        }
      },
      { rootMargin: "-20% 0px -65% 0px" },
    );
    bySlug.forEach((_, slug) => {
      const el = document.getElementById(slug);
      if (el) obs.observe(el);
    });
  }

  // Ubah blok FAQ (H2 "Pertanyaan yang sering muncul" + H3) jadi accordion <details>
  const article = document.querySelector(".article-copy");
  if (article) {
    const nodes = [...article.children];
    const faqH2 = nodes.find(
      (el) => el.tagName === "H2" && /pertanyaan yang sering muncul/i.test(el.textContent ?? ""),
    );
    if (faqH2) {
      let cur: HTMLDetailsElement | null = null;
      let node: Element | null = faqH2.nextElementSibling;
      const toMove: Element[] = [];
      while (node && node.tagName !== "H2") {
        const next = node.nextElementSibling;
        toMove.push(node);
        node = next;
      }
      // Lepas dulu semua node FAQ dari DOM agar tidak ada duplikat H3 tertinggal.
      toMove.forEach((el) => el.remove());
      const wrap = document.createElement("div");
      wrap.className = "faq-wrap";
      faqH2.replaceWith(wrap);
      // Kembalikan judul FAQ sebagai H2 biasa (tanpa nomor bab).
      const faqTitle = document.createElement("h2");
      faqTitle.className = "faq-title";
      faqTitle.textContent = faqH2.textContent?.trim() ?? "Pertanyaan yang sering muncul";
      wrap.appendChild(faqTitle);
      for (const el of toMove) {
        if (el.tagName === "H3") {
          cur = document.createElement("details");
          cur.className = "faq-item";
          cur.name = "blog-faq";
          const sum = document.createElement("summary");
          sum.innerHTML = `<span>${el.innerHTML}</span><span class="faq-plus" aria-hidden="true">+</span>`;
          cur.appendChild(sum);
          const body = document.createElement("div");
          body.className = "faq-body";
          cur.appendChild(body);
          wrap.appendChild(cur);
        } else if (cur) {
          cur.lastElementChild?.appendChild(el);
        } else {
          wrap.appendChild(el);
        }
      }
      // Buka pertanyaan pertama secara default
      wrap.querySelector("details")?.setAttribute("open", "");
    }
  }
</script>

<style>
  #read-progress {
    position: fixed; inset: 0 0 auto 0; height: 3px; z-index: 60;
    background: var(--color-wa-deep);
    transform: scaleX(0); transform-origin: 0 50%;
  }

  /* ===== TIPOGRAFI NOVEL / EDITORIAL ===== */
  .article-copy {
    font-size: 1.075rem;
    line-height: 1.85;
    color: var(--color-ink);
    overflow-wrap: break-word;
    hyphens: auto;
    counter-reset: bab;
  }
  .article-copy :global(> * + *) { margin-top: 1.35em; }
  .article-copy :global(p), .article-copy :global(li) { text-wrap: pretty; }
  .article-copy :global(p) { max-width: 68ch; }

  /* Lead: paragraf pembuka tampil sebagai intro */
  .article-copy :global(> p:first-of-type) {
    font-size: 1.13em; line-height: 1.8; color: rgb(11 27 43 / 0.88);
  }

  .article-copy :global(:is(h2, h3, h4)) {
    font-weight: 800; line-height: 1.32; letter-spacing: -0.02em;
    scroll-margin-top: 5.5rem; text-wrap: balance;
  }
  /* H2 = nomor bab editorial */
  .article-copy :global(h2) {
    counter-increment: bab;
    font-size: 1.42rem;
    padding-top: 0.4em;
    display: flex; align-items: baseline; gap: 0.6rem;
  }
  .article-copy :global(h2::before) {
    content: counter(bab, decimal-leading-zero);
    flex: none;
    font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em;
    color: var(--color-wa-deep);
    border: 1.5px solid currentColor;
    border-radius: 999px;
    padding: 0.2em 0.55em;
    transform: translateY(-0.25em);
  }
  /* H2 FAQ & penutup tidak perlu nomor bab */
  .article-copy :global(h2:has(+ .faq-wrap)),
  .article-copy :global(.faq-wrap) { counter-increment: none; }
  .article-copy :global(> * + h2) { margin-top: 2.4em; }
  .article-copy :global(h2 + *) { margin-top: 0.9em; }
  .article-copy :global(h3) { font-size: 1.16rem; margin-top: 1.8em; }
  .article-copy :global(h3 + *) { margin-top: 0.7em; }

  .article-copy :global(ul) { list-style: none; padding: 0; }
  .article-copy :global(ul > li) {
    position: relative; padding-left: 1.6em; margin-top: 0.75em;
  }
  .article-copy :global(ul > li::before) {
    content: ""; position: absolute; left: 0.25em; top: 0.72em;
    width: 0.42em; height: 0.42em; border-radius: 999px;
    background: var(--color-wa-deep);
  }
  .article-copy :global(ol) { list-style: none; padding: 0; counter-reset: langkah; }
  .article-copy :global(ol > li) {
    counter-increment: langkah;
    position: relative; padding-left: 2.6em; margin-top: 1em;
  }
  .article-copy :global(ol > li::before) {
    content: counter(langkah);
    position: absolute; left: 0; top: 0.15em;
    width: 1.7em; height: 1.7em; border-radius: 999px;
    display: grid; place-items: center;
    font-size: 0.82em; font-weight: 800;
    color: var(--color-wa-deep); background: #e6ede1;
  }
  .article-copy :global(strong) { font-weight: 750; }
  .article-copy :global(a) {
    color: var(--color-wa-deep); font-weight: 650;
    text-decoration: underline; text-underline-offset: 0.2em;
    text-decoration-thickness: 1.5px;
  }
  .article-copy :global(a:hover) { text-decoration-thickness: 2.5px; }

  /* Paragraf yang hanya berisi 1 link WA → kartu CTA, bukan link sebaris */
  .article-copy :global(p:has(> a:only-child[href*="wa.me"])) {
    margin-top: 1.6em;
    border: 1px solid var(--color-line);
    border-left: 4px solid var(--color-wa-deep);
    background: #fff;
    border-radius: 1rem;
    padding: 1rem 1.15rem;
    display: flex; align-items: center; gap: 0.8rem;
    font-size: 0.95em; line-height: 1.6;
  }
  .article-copy :global(p:has(> a:only-child[href*="wa.me"])::before) {
    content: "WA";
    flex: none; display: grid; place-items: center;
    width: 2.4em; height: 2.4em; border-radius: 999px;
    background: var(--color-wa-deep); color: #fff;
    font-size: 0.78em; font-weight: 800; letter-spacing: 0.02em;
  }
  .article-copy :global(p:has(> a:only-child[href*="wa.me"]) a) { text-decoration: none; }
  .article-copy :global(p:has(> a:only-child[href*="wa.me"]) a:hover) { text-decoration: underline; }

  /* Contoh hitungan & kutipan → callout */
  .article-copy :global(blockquote) {
    border: 1px solid var(--color-line);
    border-left: 4px solid var(--color-wa-deep);
    background: #fbfaf6;
    border-radius: 0 1rem 1rem 0;
    padding: 1rem 1.2rem;
    color: rgb(11 27 43 / 0.85);
    font-size: 0.96em;
  }

  .article-copy :global(img) { max-width: 100%; height: auto; border-radius: 1rem; }
  .article-copy :global(hr) { border: 0; border-top: 1px dashed var(--color-line); margin: 2.2em auto; max-width: 12rem; }
  .article-copy :global(table) {
    display: block; max-width: 100%; overflow-x: auto;
    border: 1px solid var(--color-line); border-radius: 0.9rem;
    font-size: 0.875rem; line-height: 1.55;
  }
  .article-copy :global(th), .article-copy :global(td) {
    padding: 0.7rem 0.9rem; border-bottom: 1px solid var(--color-line);
    text-align: left; vertical-align: top;
  }
