---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ChatSample from "../components/ChatSample.astro";
import SocialProof from "../components/SocialProof.astro";
import Risks from "../components/Risks.astro";
import Options from "../components/Options.astro";
import HowItWorks from "../components/HowItWorks.astro";
import About from "../components/About.astro";
import Faq from "../components/Faq.astro";
import FinalCta from "../components/FinalCta.astro";
import BlogTeaser from "../components/BlogTeaser.astro";
import { homeFaqs } from "../data/home-faqs";
---

<BaseLayout
  title="Cek Polis Mobil Gratis di BSD & Gading Serpong | Aditya"
  description="Polis mobil mau habis? Kirim foto halaman depan polis, saya cek banjir, biaya sendiri, dan bengkelnya. Gratis. BSD, Gading Serpong, Alam Sutera."
  schemaType="home"
  faqs={homeFaqs}
>
  <Hero />
  <ChatSample />
  <SocialProof />
  <Risks />
  <Options />
  <HowItWorks />
  <About />
  <Faq />
  <FinalCta title="Sebelum puncak hujan Desember sampai Februari, pastikan banjir sudah masuk polis Anda." />
  <BlogTeaser />
</BaseLayout>
