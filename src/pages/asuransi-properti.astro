---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogTeaser from "../components/BlogTeaser.astro";
import About from "../components/About.astro";
import FinalCta from "../components/FinalCta.astro";
import FaqSection from "../components/FaqSection.astro";
import ProductHero from "../components/ProductHero.astro";
import WaButton from "../components/WaButton.astro";
import {
  ArrowDown,
  Building2,
  ChevronDown,
  CloudRain,
  House,
} from "lucide-astro";

const consultationMessage = "Halo Aditya, saya ingin cek estimasi premi asuransi properti.";
const rumahMessage = "Halo Aditya, saya ingin cek premi asuransi rumah tinggal.";
const rukoMessage = "Halo Aditya, saya ingin cek asuransi ruko atau tempat usaha.";
const estimateMessage = consultationMessage;

const faqs = [
  {
    question: "Apakah harga tanah ikut dihitung dalam nilai pertanggungan?",
    answer: "Tidak. Nilai pertanggungan bangunan dihitung dari perkiraan biaya membangun kembali bangunan, bukan harga tanah. Isi bangunan dapat dihitung terpisah sesuai kebutuhan dan ketentuan produk.",
  },
  {
    question: "Bagaimana kalau ruko saya berada di area rawan banjir?",
    answer: "Kirim alamat dan foto rukonya. Saya cek apakah banjir bisa ditambahkan, berapa tambahan premi, dan apa syarat dari asuransinya.",
  },
  {
    question: "Bagaimana proses klaim kalau terjadi kebakaran?",
    answer: "Utamakan keselamatan dan hubungi pemadam kebakaran (113). Setelah situasi aman, hubungi perusahaan asuransi, lalu chat saya. Foto kondisi bangunan sebelum membersihkan apa pun. Surveyor asuransi akan memeriksa kerugian, dan saya bantu mendampingi lewat WhatsApp dengan arahan dokumen yang perlu disiapkan. Keputusan klaim mengikuti pemeriksaan dan ketentuan polis.",
  },
  {
    question: "Apakah rumah perlu disurvei sebelum diasuransikan?",
    answer: "Untuk rumah tinggal, proses awal biasanya bisa dilakukan online melalui WhatsApp tanpa survei awal. Perusahaan asuransi dapat meminta foto, dokumen, atau survei tambahan berdasarkan kondisi dan lokasi properti. Ruko dan tempat usaha umumnya memerlukan survei lokasi lebih dulu.",
  },
  {
    question: "Rumah saya KPR dan sudah ada asuransi dari bank. Perlu dicek lagi?",
    answer: "Kirim polisnya. Saya cek apa saja yang dijamin dan apakah banjir ikut.",
  },
];

const rupiah = (value: number) => `Rp${new Intl.NumberFormat("id-ID").format(value)}`;

const premiDasar = 500000;
const tambahanTetap = [
  { label: "Kerusuhan dan huru hara", amount: 2000 },
  { label: "Risiko lainnya (termasuk tertabrak kendaraan dan bongkaran)", amount: 2000 },
];
const biayaLainnya = { label: "Biaya admin", amount: 120000 };
const perluasan = [
  { id: "banjir", label: "Banjir, Angin Topan, Badai dan kerusakan akibat air", amount: 800000 },
  { id: "gempa", label: "Gempa Bumi, Letusan Gunung Berapi dan Tsunami", amount: 2200000 },
];
const totalDasar =
  premiDasar + tambahanTetap.reduce((sum, item) => sum + item.amount, 0) + biayaLainnya.amount;
---

<BaseLayout
      title="Asuransi Rumah & Ruko BSD, Gading Serpong, Alam Sutera | Aditya"
      description="Asuransi rumah dan ruko dihitung dari biaya bangun, bukan harga tanah. Cek FLEXAS, PAR, dan jaminan banjir bersama Aditya. BSD, Gading Serpong, Alam Sutera."
  stickyMessage={consultationMessage}
  faqs={faqs}
>
  <article class="overflow-hidden bg-paper">
    <ProductHero
      product="Asuransi Properti"
      eyebrow="Asuransi properti · BSD · Gading Serpong · Alam Sutera"
      titleLead="Asuransi rumah dan ruko"
      titleAccent="dihitung dari biaya bangun, bukan harga tanah."
      lead="Saya bantu hitung nilai bangunannya, pilih perlindungan yang pas, dan cek apakah banjir bisa ditambahkan."
      message={rumahMessage}
      ctaLabel="Cek Premi Rumah"
      secondaryMessage={rukoMessage}
      secondaryLabel="Jadwalkan Survei Ruko"
      helperLine="Punya polis dari bank untuk KPR? Kirim saja, saya cek apa yang dijamin dan apakah banjir ikut."
      checks={["Konsultasi gratis, tidak harus beli", "Aditya tinggal di Serpong"]}
      stackChecks
      background="property"
      summary={{
        icon: Building2,
        eyebrow: "Yang bisa Anda tanyakan",
        title: "Mulai dari kebutuhan properti Anda",
        items: [
          { icon: House, label: "Pilihan perlindungan untuk rumah, ruko, atau usaha" },
          { icon: Building2, label: "Perkiraan premi sesuai kondisi properti" },
          { icon: CloudRain, label: "Cek isi polis yang sudah Anda punya" },
        ],
        note: "Cakupan, sublimit, dan pengecualian mengikuti penawaran dan polis.",
      }}
    />

    <section aria-label="Contoh biaya asuransi rumah" class="bg-paper px-5 py-10 md:py-14">
      <div class="mx-auto max-w-6xl">
        <div class="relative isolate overflow-hidden rounded-[2rem] bg-gradient-to-br from-ink via-ink to-ink-2 p-7 text-white shadow-2xl shadow-ink/30 ring-1 ring-white/10 md:p-11">
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
            <div class="absolute -right-24 top-1/2 h-72 w-72 -translate-y-1/2 rounded-full bg-wa/15 blur-3xl"></div>
            <div class="absolute -left-24 -top-24 h-64 w-64 rounded-full bg-sky-400/10 blur-3xl"></div>
            <svg viewBox="0 0 600 500" fill="none" class="absolute -right-10 bottom-0 h-[115%] w-auto max-w-none text-white/[0.06] md:-right-4" preserveAspectRatio="xMaxYMax meet">
              <path d="M35 460V255L160 155L285 255V460M85 460V290H235V460M160 155V65L255 125V230M285 460V205L405 120L535 205V460M330 460V235H490V460M35 460H570" stroke="currentColor" stroke-width="2" />
              <path d="M115 325H205V390H115zM360 275H410V330H360zM435 275H465V330H435zM380 460V375H450V460" stroke="currentColor" stroke-width="2" />
            </svg>
          </div>

          <div class="relative grid gap-8 md:grid-cols-[1fr_auto] md:items-center md:gap-11">
            <p class="type-subsection max-w-2xl text-white/95">
              Banyak pemilik rumah mengira asuransi properti itu mahal. Padahal, bangunan senilai <span class="whitespace-nowrap text-sky-300">Rp1,4 miliar</span> premi dasarnya hanya <span class="relative inline-block whitespace-nowrap font-extrabold text-wa"><span aria-hidden="true" class="absolute inset-x-0 bottom-0.5 -z-10 h-2.5 rounded-full bg-wa/25 md:h-3"></span>Rp500ribu</span> per tahun.
            </p>

            <div class="md:border-l md:border-dashed md:border-white/20 md:pl-11">
              <a href="#biaya" class="group inline-flex min-h-[3.5rem] w-full shrink-0 items-center justify-center gap-3 self-start rounded-full bg-white py-2.5 pl-6 pr-2.5 font-display text-[0.9375rem] font-extrabold text-ink shadow-xl shadow-black/40 transition hover:bg-wa-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-wa focus-visible:ring-offset-2 focus-visible:ring-offset-ink md:w-auto">
                Coba Simulasi Sekarang
                <span aria-hidden="true" class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-wa-deep text-white transition-transform group-hover:translate-y-0.5">
                  <ArrowDown class="h-4 w-4" stroke-width={2.75} />
                </span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="risiko" class="px-5 py-16 md:py-24">
      <div class="mx-auto max-w-6xl">
        <div class="max-w-3xl">
          <p class="type-eyebrow text-wa-deep">Kenapa perlu perlindungan?</p>
          <h2 class="type-section mt-3">Tiga hal yang sering terlewat</h2>
          <p class="type-section-lead mt-4 text-muted">Rumah dan ruko di Alam Sutera, BSD, dan Gading Serpong dapat terdampak risiko yang biaya pemulihannya tidak kecil.</p>
        </div>
        <div class="mt-8 grid gap-4 md:grid-cols-3">
          <article class="rounded-3xl border border-line bg-white p-5 md:p-6">
            <span class="grid h-11 w-11 place-items-center rounded-2xl bg-wa-soft text-wa-deep"><CloudRain class="h-5 w-5" /></span>
            <h3 class="type-card-title mt-4">Banjir tidak ikut otomatis.</h3>
            <p class="type-card-body mt-2 text-muted">Polis dasar kebakaran tidak menjamin banjir. Perluasannya harus diminta.</p>
          </article>
          <article class="rounded-3xl border border-line bg-white p-5 md:p-6">
            <span class="grid h-11 w-11 place-items-center rounded-2xl bg-wa-soft text-wa-deep"><Building2 class="h-5 w-5" /></span>
            <h3 class="type-card-title mt-4">Nilai bangunan dihitung terlalu rendah.</h3>
            <p class="type-card-body mt-2 text-muted">Kalau nilai pertanggungan di bawah biaya bangun, klaim bisa dikurangi secara proporsional sesuai polis.</p>
          </article>
          <article class="rounded-3xl border border-line bg-white p-5 md:p-6">
            <span class="grid h-11 w-11 place-items-center rounded-2xl bg-wa-soft text-wa-deep"><House class="h-5 w-5" /></span>
            <h3 class="type-card-title mt-4">Bangunan berubah.</h3>
            <p class="type-card-body mt-2 text-muted">Renovasi, tambah lantai, atau ganti fungsi bangunan sebaiknya diinformasikan ke asuransi, karena bisa mengubah nilai dan risikonya.</p>
          </article>
        </div>
        <div class="type-body-sm mt-5 flex gap-3 rounded-2xl border border-wa-deep/15 bg-wa-soft p-4 text-wa-deep md:p-5">
          <House class="mt-0.5 h-5 w-5 shrink-0" />
          <p><strong>Proses menyesuaikan jenis properti.</strong> Rumah tinggal dapat dikonsultasikan online lewat WhatsApp tanpa survei awal. Untuk ruko dan tempat usaha, survei lokasi biasanya dijadwalkan lebih dulu.</p>
        </div>
      </div>
    </section>

    <section id="perlindungan" class="border-y border-line bg-white px-5 py-16 md:py-24">
      <div class="mx-auto max-w-6xl">
        <div class="max-w-3xl">
          <p class="type-eyebrow text-wa-deep">Bandingkan manfaat</p>
          <h2 class="type-section mt-3">Pilih perlindungan sesuai risiko properti Anda.</h2>
        </div>
        <div class="mt-8 grid gap-4 md:grid-cols-3">
          <article class="rounded-3xl border border-line bg-paper p-5 md:p-6">
            <h3 class="type-panel-title">FLEXAS</h3>
            <p class="type-card-body mt-2 text-muted">Menjamin risiko yang disebut satu per satu di polis: kebakaran, petir, ledakan, pesawat jatuh, asap. Banjir dan risiko lain harus ditambah.</p>
          </article>
          <article class="rounded-3xl border border-line bg-paper p-5 md:p-6">
            <h3 class="type-panel-title">PAR (Property All Risks)</h3>
            <p class="type-card-body mt-2 text-muted">Menjamin kerusakan fisik dari sebab apa pun, kecuali yang dikecualikan di polis. Cakupan lebih luas, premi biasanya lebih tinggi.</p>
          </article>
          <article class="rounded-3xl border border-wa-deep/20 bg-wa-soft p-5 md:p-6">
            <h3 class="type-panel-title">Mana yang cocok?</h3>
            <p class="type-card-body mt-2 text-ink/80">Kirim jenis bangunan dan alamatnya. Saya jelaskan mana yang masuk akal.</p>
          </article>
        </div>
        <p class="type-section-lead mt-4 text-muted">Cakupan, sublimit, perluasan, dan pengecualian mengikuti wording polis. &ldquo;All Risks&rdquo; tidak berarti semua penyebab otomatis dijamin.</p>
        <WaButton message={consultationMessage} class="mt-5 w-full sm:w-auto">Tanya pilihan perlindungan</WaButton>
      </div>
    </section>

    <section id="biaya" class="px-5 py-16 md:py-24">
      <div class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-14">
        <div>
          <p class="type-eyebrow text-wa-deep">Simulasi biaya</p>
          <h2 class="type-section mt-3">Kira-kira berapa premi properti?</h2>
          <p class="type-section-lead mt-4 text-muted">Contoh estimasi untuk rumah tinggal dengan nilai bangunan Rp1,4 miliar. Ini ilustrasi premi, bukan penawaran atau jaminan tarif dan tidak memastikan perluasan tertentu sudah termasuk.</p>
        </div>
        <div>
          <div class="overflow-hidden rounded-3xl border border-line bg-white" data-premi-base={totalDasar}>
            <div class="border-b border-line bg-paper px-4 py-4 md:px-5">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <p class="type-eyebrow text-wa-deep">Simulasi premi</p>
                <span class="type-fine rounded-full border border-line bg-white px-3 py-1 font-semibold text-muted">Kelas Konstruksi 1</span>
              </div>
              <p class="type-card-title mt-2">Rumah tinggal Rp1,4 miliar</p>
              <p class="type-body-sm mt-1 font-semibold text-wa-deep">Estimasi Property All Risks (PAR)</p>
              <p class="type-fine mt-1 text-muted">Nilai bangunan {rupiah(1400000000)}, tidak termasuk harga tanah.</p>
            </div>
            <div class="divide-y divide-line">
              <div class="px-4 py-3.5 md:px-5">
                <div class="flex items-baseline justify-between gap-4">
                  <span class="type-body-sm text-muted">Premi dasar</span>
                  <span class="type-body-sm shrink-0 font-bold text-ink tabular-nums">{rupiah(premiDasar)}</span>
                </div>
                <p class="type-fine mt-1 text-muted">Tarif dasar setara FLEXAS (Asuransi Kebakaran). Dengan tambahan perluasan di bawah, cakupan sudah naik ke Property All Risks.</p>
              </div>

              <p class="type-eyebrow bg-paper px-4 py-2.5 text-wa-deep md:px-5">Tambahan perlindungan</p>
              {tambahanTetap.map((item) => (
                <div class="flex items-start justify-between gap-4 px-4 py-3.5 md:px-5">
                  <span class="type-body-sm text-muted">{item.label}</span>
                  <span class="type-body-sm shrink-0 font-bold text-ink tabular-nums">{rupiah(item.amount)}</span>
                </div>
              ))}

              <div class="bg-paper px-4 py-2.5 md:px-5">
                <p class="type-eyebrow text-wa-deep">Pilih perluasan</p>
                <p class="type-fine mt-1 text-muted">Centang untuk menambahkan. Total di bawah ikut berubah.</p>
              </div>
              {perluasan.map((item) => (
                <label class="flex cursor-pointer items-start gap-3 px-4 py-3.5 transition hover:bg-wa-soft/60 md:px-5">
                  <input
                    id={`opsi-${item.id}`}
                    type="checkbox"
                    data-premi-add={item.amount}
                    class="mt-0.5 h-5 w-5 shrink-0 cursor-pointer accent-wa-deep"
                  />
                  <span class="type-body-sm min-w-0 flex-1 text-ink">{item.label}</span>
                  <span class="type-body-sm shrink-0 font-bold text-ink tabular-nums">+{rupiah(item.amount)}</span>
                </label>
              ))}

              <p class="type-eyebrow bg-paper px-4 py-2.5 text-wa-deep md:px-5">Biaya lainnya</p>
              <div class="flex items-baseline justify-between gap-4 px-4 py-3.5 md:px-5">
                <span class="type-body-sm text-muted">{biayaLainnya.label}</span>
                <span class="type-body-sm shrink-0 font-bold text-ink tabular-nums">{rupiah(biayaLainnya.amount)}</span>
              </div>

              <div class="flex items-center justify-between gap-3 bg-ink px-4 py-4 text-white md:px-5">
                <div>
                  <p class="type-body-sm font-semibold">Total estimasi premi</p>
                  <p class="type-fine text-white/70">per tahun</p>
                </div>
                <p id="premi-total" aria-live="polite" class="type-panel-title tabular-nums">{rupiah(totalDasar)}</p>
              </div>
            </div>
            <p class="type-card-body border-t border-line px-4 py-3 text-muted md:px-5">Total sudah termasuk biaya admin, belum termasuk materai dan biaya polis lain. Cakupan dan premi final mengikuti penawaran.</p>
          </div>
          <p class="type-fine mt-3 text-muted">Premi final bergantung pada kondisi dan lokasi bangunan, perluasan yang dipilih, ketentuan perusahaan, serta hasil penilaian risiko.</p>
          <WaButton message={estimateMessage} class="mt-5 w-full sm:w-auto">Tanya estimasi properti saya</WaButton>

          <details class="group mt-5 rounded-2xl border border-line bg-white px-4 py-3.5 md:px-5">
            <summary class="flex min-h-8 cursor-pointer list-none items-center justify-between gap-4 font-display text-[1rem] font-bold marker:hidden [&::-webkit-details-marker]:hidden">
              Ketentuan penting sebelum menghitung nilai pertanggungan<ChevronDown class="h-5 w-5 shrink-0 text-muted transition group-open:rotate-180" />
            </summary>
            <ul class="type-card-body grid gap-3 pt-3 pr-7 text-muted">
              <li><strong class="text-ink">Kelas konstruksi:</strong> Contoh ini menggunakan Kelas Konstruksi 1, dengan dinding, lantai, dan atap dari bahan yang tidak mudah terbakar seperti beton dan bata. Klasifikasi akhir mengikuti penilaian perusahaan asuransi.</li>
              <li><strong class="text-ink">Nilai pertanggungan:</strong> dihitung dari nilai fisik bangunan atau biaya membangun kembali, tidak termasuk harga tanah.</li>
              <li><strong class="text-ink">Risiko sendiri (deductible):</strong> bagian biaya klaim yang menjadi tanggungan pemegang polis, sesuai jumlah dan ketentuan di polis.</li>
            </ul>
          </details>
        </div>
      </div>
    </section>

    <section id="cara-kerja" class="border-y border-line bg-white px-5 py-16 md:py-24">
      <div class="mx-auto max-w-6xl">
        <div class="max-w-3xl">
          <p class="type-eyebrow text-wa-deep">Cara kerja</p>
          <h2 class="type-section mt-3">Tiga langkah, dari chat sampai polis terbit.</h2>
        </div>
        <div class="mt-8 grid gap-3 md:grid-cols-3">
          <article class="rounded-3xl border border-line bg-paper p-5 md:p-6">
            <span class="grid h-10 w-10 place-items-center rounded-full bg-ink font-display text-[0.875rem] font-extrabold text-white">01</span>
            <h3 class="type-card-title mt-4">Mulai dengan bertanya</h3>
            <p class="type-card-body mt-2 text-muted">Ceritakan kebutuhan Anda lewat WhatsApp. Untuk penawaran, saya akan bantu menyiapkan data seperti lokasi, ukuran, fungsi, dan spesifikasi bangunan.</p>
          </article>
          <article class="rounded-3xl border border-line bg-paper p-5 md:p-6">
            <span class="grid h-10 w-10 place-items-center rounded-full bg-ink font-display text-[0.875rem] font-extrabold text-white">02</span>
            <h3 class="type-card-title mt-4">Terima penawaran</h3>
            <p class="type-card-body mt-2 text-muted">Saya bantu bandingkan pilihan dari perusahaan rekanan dan jelaskan manfaat serta ketentuan utamanya.</p>
          </article>
          <article class="rounded-3xl border border-line bg-paper p-5 md:p-6">
            <span class="grid h-10 w-10 place-items-center rounded-full bg-ink font-display text-[0.875rem] font-extrabold text-white">03</span>
            <h3 class="type-card-title mt-4">Polis diterbitkan</h3>
            <p class="type-card-body mt-2 text-muted">Setelah menyetujui penawaran dan pembayaran terverifikasi, polis elektronik dikirim melalui email.</p>
          </article>
        </div>
      </div>
    </section>

    <About message={consultationMessage} />

    <FaqSection
      faqs={faqs}
      title="FAQ asuransi properti"
      description="Jawaban umum soal nilai bangunan, banjir, survei, dan klaim. Penawaran dan polis resmi tetap menjadi acuan."
      cta={{ message: consultationMessage, label: "Tanya soal properti via WhatsApp" }}
    />

  </article>

  <FinalCta
    title="Ada pertanyaan soal asuransi properti? Tanya Aditya dulu."
    message={consultationMessage}
  />

  <BlogTeaser
    eyebrow="Blog"
    title="Tips & Informasi"
    subtitle="Panduan singkat soal nilai bangunan, KPR lunas, dan jaminan banjir."
    limit={5}
    leadId="panduan-asuransi-rumah-tinggal-bsd-alam-sutera"
  />
</BaseLayout>

<script>
  (function () {
    const card = document.querySelector<HTMLElement>("[data-premi-base]");
    const totalEl = document.getElementById("premi-total");
    if (!card || !totalEl) return;

    const base = Number(card.dataset.premiBase || 0);
    const addons = card.querySelectorAll<HTMLInputElement>("input[data-premi-add]");
    const format = (value: number) => "Rp" + new Intl.NumberFormat("id-ID").format(value);

    const update = () => {
      let total = base;
      addons.forEach((input) => {
        if (input.checked) total += Number(input.dataset.premiAdd || 0);
      });
      totalEl.textContent = format(total);
    };

    addons.forEach((input) => input.addEventListener("change", update));
    update();
  })();
</script>
