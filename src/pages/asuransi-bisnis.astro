---
import BaseLayout from "../layouts/BaseLayout.astro";
import About from "../components/About.astro";
import FinalCta from "../components/FinalCta.astro";
import FaqSection from "../components/FaqSection.astro";
import ProductHero from "../components/ProductHero.astro";
import WaButton from "../components/WaButton.astro";
import WaLink from "../components/WaLink.astro";
import { MESSAGES } from "../data/config";
import {
  ArrowUpRight,
  Box,
  BriefcaseBusiness,
  Building2,
  FileCheck,
  HeartPulse,
  ShieldPlus,
  Truck,
} from "lucide-astro";

const heroMessage = "Halo Aditya, saya ingin berkonsultasi asuransi untuk usaha saya. Jenis usaha: ... Lokasi: ... Yang ingin dilindungi: ...";
const otherMessage = "Halo Aditya, saya ingin membahas kebutuhan perlindungan lain untuk usaha saya.";

const services = [
  {
    name: "Kendaraan operasional (Fleet)",
    icon: Truck,
    description: "Mobil box, pick up, atau kendaraan operasional lain. Melindungi dari kerusakan dan kehilangan sesuai polis.",
    cta: "Konsultasi kendaraan",
    message: "Halo Aditya, saya mau tanya asuransi kendaraan operasional usaha saya. Jenis usaha: ... Jumlah dan jenis kendaraan: ... Polis lama berakhir kapan: ...",
  },
  {
    name: "Ruko, kantor, gudang, dan stok",
    icon: Building2,
    description: "Dihitung dari nilai bangunan dan isinya, bukan harga tanah.",
    cta: "Lihat asuransi properti",
    href: "/asuransi-properti/",
  },
  {
    name: "Karyawan (Group Health dan PA Group)",
    icon: HeartPulse,
    description: "Kesehatan untuk sekelompok karyawan dalam satu polis, dan santunan jika terjadi kecelakaan yang menyebabkan cacat atau meninggal dunia.",
    cta: "Konsultasi karyawan",
    message: "Halo Aditya, saya mau tanya asuransi karyawan (Group Health atau PA Group). Jumlah karyawan: ... Rentang usia: ... Jenis usaha: ...",
  },
  {
    name: "Pengiriman barang (Marine Cargo)",
    icon: Box,
    description: "Barang rusak atau hilang selama pengiriman.",
    cta: "Konsultasi pengiriman",
    message: "Halo Aditya, saya mau tanya asuransi pengiriman barang. Jenis barang: ... Rute: ... Perkiraan nilai per pengiriman: ...",
  },
];

const steps: { title: string; text?: string }[] = [
  { title: "Ceritakan usahanya.", text: "Jenis usaha, lokasi, dan apa yang ingin dilindungi. Untuk chat pertama, cukup gambaran umumnya dulu." },
  { title: "Saya kirim pilihan dan penjelasannya.", text: "Saya terjemahkan kebutuhan Anda jadi pilihan polis, lengkap dengan manfaat, batas pertanggungan, dan pengecualiannya." },
  { title: "Cocok? Saya urus.", text: "Dokumen pengajuan saya pandu dan prosesnya saya ikuti sampai polis terbit." },
];

const faqs = [
  {
    question: "Usaha saya kecil. Perlu asuransi bisnis?",
    answer: "Mulai dari yang paling mahal kalau rusak: kendaraan, bangunan, stok. Tidak perlu semuanya sekaligus.",
  },
  {
    question: "Sudah ada polis dari bank atau pemberi kredit. Masih perlu dicek?",
    answer: "Kirim saja. Saya cek apa yang dijamin.",
  },
  {
    question: "Apa yang biasanya tidak dijamin?",
    answer: "Paling sering: keausan, kerusakan yang terjadi pelan-pelan, dan barang yang tidak tercatat di polis. Daftar lengkapnya ada di bagian pengecualian, dan isinya beda tiap produk.",
  },
  {
    question: "Kendaraan operasional dipakai bergantian. Tetap dijamin?",
    answer: "Tergantung polis: ada yang mengikuti kendaraannya, ada yang mengikuti pengemudinya. Sebutkan siapa saja yang biasa mengemudi saat pengajuan, supaya tidak jadi masalah waktu klaim.",
  },
  {
    question: "Karyawan saya sedikit dan sering berganti. Bisa Group Health?",
    answer: "Bisa, tapi Group Health biasanya punya syarat jumlah peserta minimum. Kalau timnya kecil, PA Group atau polis perorangan untuk beberapa karyawan kunci kadang lebih masuk akal.",
  },
  {
    question: "Berapa lama sampai polis terbit?",
    answer: "Kalau data lengkap dan tidak perlu survei, bisa selesai dalam beberapa hari kerja. Ruko, gudang, dan nilai pertanggungan besar umumnya disurvei dulu.",
  },
  {
    question: "Premi bisa dicicil?",
    answer: "Beberapa produk bisa dibayar bertahap, tergantung perusahaan dan nilai preminya. Saya cek pilihannya saat kirim penawaran.",
  },
  {
    question: "Kalau terjadi musibah, siapa yang bantu?",
    answer: "Hubungi dulu nomor darurat perusahaan yang tertera di polis, lalu chat saya. Saya bantu arahkan dokumen dan ikuti pengajuannya. Keputusan tetap dari perusahaan asuransi.",
  },
];
---

<BaseLayout
  title="Asuransi Bisnis & Usaha di BSD dan Gading Serpong | Aditya"
  description="Asuransi untuk usaha di Serpong: kendaraan operasional, karyawan, dan pengiriman barang. Ceritakan usaha Anda, saya bantu pilih."
  stickyMessage={heroMessage}
  faqs={faqs}
>
  <article class="bg-paper">
    <ProductHero
      product="Asuransi Bisnis"
      eyebrow="Asuransi bisnis · BSD · Gading Serpong · Alam Sutera"
      titleLead="Asuransi untuk usaha,"
      titleAccent="tanpa harus hafal istilahnya."
      lead="Ceritakan jenis usaha, lokasi, dan apa yang ingin dilindungi. Saya terjemahkan ke pilihan polis cocok, lalu bantu siapkan data pengajuannya."
      message={heroMessage}
      ctaLabel="Ceritakan usaha Anda"
      secondary={{ href: "#layanan", label: "Lihat layanan" }}
      checks={["Konsultasi awal lewat WhatsApp", "Tidak perlu memilih produk dulu"]}
      stackChecks
      background="property"
      summary={{
        icon: BriefcaseBusiness,
        title: "Ceritakan tiga hal ini",
        items: [
          { icon: Building2, label: "Bidang usaha dan lokasi operasional" },
          { icon: ShieldPlus, label: "Apa yang ingin Anda lindungi" },
          { icon: FileCheck, label: "Kapan perlindungan dibutuhkan" },
        ],
        note: "Untuk chat pertama, cukup berikan gambaran umum. Dokumen atau survei bisa diperlukan, tergantung produk dan penilaian risiko.",
      }}
    />

    <section id="layanan" aria-labelledby="judul-layanan" class="scroll-mt-24 px-5 py-16 md:py-24">
      <div class="mx-auto max-w-6xl">
        <div class="max-w-3xl">
          <p class="type-eyebrow text-wa-deep">Layanan Asuransi Bisnis</p>
          <h2 id="judul-layanan" class="type-section mt-3">Usaha Anda butuh apa?</h2>
          <p class="type-section-lead mt-4 text-muted">Pilih layanan yang ingin dibahas. Premi, manfaat, batas pertanggungan, dan pengecualian mengikuti penawaran dan ketentuan polis.</p>
        </div>
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {services.map((service) => {
            const Icon = service.icon;
            return (
              <article class="flex flex-col items-start rounded-3xl border border-line bg-white p-5 md:p-6">
                <span class="grid h-10 w-10 place-items-center rounded-2xl bg-wa-soft text-wa-deep">
                  <Icon class="h-5 w-5" aria-hidden="true" />
                </span>
                <h3 class="type-card-title mt-4">{service.name}</h3>
                <p class="type-card-body mt-2 mb-3 text-muted">{service.description}</p>
                {service.href ? (
                  <a href={service.href} class="type-body-sm mt-auto inline-flex min-h-11 items-center gap-1.5 rounded-sm font-bold text-wa-deep underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-wa-deep">
                    {service.cta}
                    <ArrowUpRight class="h-4 w-4" aria-hidden="true" />
                  </a>
                ) : (
                  <WaLink message={service.message!} class="type-body-sm mt-auto inline-flex min-h-11 items-center gap-1.5 rounded-sm font-bold text-wa-deep underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-wa-deep">
                    {service.cta}
                    <ArrowUpRight class="h-4 w-4" aria-hidden="true" />
                  </WaLink>
                )}
              </article>
            );
          })}
        </div>
        <p class="type-section-lead mt-5 text-muted">
          Perjalanan dinas? <a href="/asuransi-travel/" class="font-bold text-wa-deep underline decoration-wa-deep/30 underline-offset-4 hover:decoration-wa-deep">Lihat Asuransi Perjalanan</a>.
        </p>
        <div class="mt-6 rounded-3xl bg-ink p-6 text-white md:flex md:items-center md:justify-between md:gap-8 md:p-8">
          <div class="max-w-xl">
            <h3 class="type-panel-title">Kebutuhan lain</h3>
            <p class="type-card-body mt-2 text-white/75">Proyek, tanggung jawab hukum, atau kebutuhan lain? Tanyakan. Kalau produknya perlu ditangani tim khusus, saya koordinasikan dengan pihak asuransi.</p>
          </div>
          <WaButton message={otherMessage} class="mt-4 w-full shrink-0 md:mt-0 md:w-auto md:px-8">Bahas kebutuhan lain</WaButton>
        </div>
      </div>
    </section>

    <section class="px-5 py-16 md:py-24">
      <div class="mx-auto max-w-6xl">
        <h2 class="type-section">Cara kerja</h2>
        <div class="mt-8 grid gap-4 md:grid-cols-3">
          {steps.map((step, i) => (
            <article class="rounded-3xl border border-line bg-paper p-5 md:p-6">
              <span class="grid h-10 w-10 place-items-center rounded-full bg-ink font-display text-[0.875rem] font-extrabold text-white">0{i + 1}</span>
              <h3 class="type-card-title mt-4">{step.title}</h3>
              {step.text && <p class="type-card-body mt-2 text-muted">{step.text}</p>}
            </article>
          ))}
        </div>
      </div>
    </section>

    <FaqSection
      faqs={faqs}
      title="FAQ asuransi bisnis"
      description="Jawaban umum soal perlindungan usaha Anda. Penawaran dan polis resmi tetap menjadi acuan."
      cta={{ message: MESSAGES.bisnis, label: "Tanya soal asuransi bisnis" }}
    />

    <About message={MESSAGES.bisnis} />
  </article>

  <FinalCta
    title="Belum tahu asuransi mana yang cocok? Ceritakan kebutuhan usaha Anda."
    message={heroMessage}
    ctaLabel="Ceritakan usaha Anda"
  />
</BaseLayout>
