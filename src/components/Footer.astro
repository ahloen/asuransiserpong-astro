---
import { BLOG_LINK, EMERGENCY_NUMBER_LINKS, FOOTER_LINKS, SERVICE_LINKS, WORKING_HOURS } from "../data/config";
import { ChevronDown, Clock, MapPin } from "lucide-astro";
import Wordmark from "./Wordmark.astro";
---

<footer class="border-t border-white/10 bg-[#07121d] px-5 pt-11 pb-8 text-white/70">
  <div class="mx-auto max-w-5xl">
    <div class="grid gap-10 md:grid-cols-[1.35fr_1fr_1fr]">
      <div>
        <a href="/" class="inline-block text-white">
          <Wordmark />
        </a>

        <p class="type-body-sm mt-4 max-w-xs text-white/60">
          Konsultasi asuransi mobil, properti, perjalanan, dan bisnis.
        </p>

        <ul class="type-meta mt-4 space-y-2 text-white/65">
          <li class="flex items-center gap-2">
            <MapPin class="h-4 w-4 shrink-0 text-wa" />
            <span>BSD · Gading Serpong · Alam Sutera</span>
          </li>
          <li class="flex items-start gap-2">
            <Clock class="mt-0.5 h-4 w-4 shrink-0 text-wa" />
            <span class="leading-relaxed">{WORKING_HOURS}</span>
          </li>
        </ul>
      </div>

      <div class="grid gap-1 md:col-span-2 md:grid-cols-2 md:gap-8">
        <nav aria-label="Menu halaman" data-footer-acc class="border-b border-white/10 md:border-0">
          <h2>
            <button
              type="button"
              data-footer-toggle
              aria-expanded="false"
              aria-controls="footer-panel-menu"
              class="flex min-h-11 w-full items-center justify-between gap-3 py-2 text-left md:pointer-events-none md:py-0"
            >
              <span class="type-eyebrow text-white/65">Menu</span>
              <ChevronDown data-footer-chevron class="h-5 w-5 shrink-0 text-white/60 transition-transform duration-300 md:hidden" />
            </button>
          </h2>
          <div id="footer-panel-menu" data-footer-panel inert class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 md:grid-rows-[1fr]">
            <div class="overflow-hidden">
              <ul class="type-body-sm space-y-1 pt-1.5 pb-4 md:mt-3.5 md:pt-0 md:pb-0">
                {FOOTER_LINKS.map((l) => (
                  <li>
                    <a href={l.href} class="inline-flex min-h-9 items-center font-medium text-white/75 transition hover:text-white">
                      {l.label}
                    </a>
                  </li>
                ))}
                <li>
                  <a href={BLOG_LINK.href} class="inline-flex min-h-9 items-center font-medium text-white/75 transition hover:text-white">
                    {BLOG_LINK.label}
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </nav>

        <div data-footer-acc class="border-b border-white/10 md:border-0">
          <h2>
            <button
              type="button"
              data-footer-toggle
              aria-expanded="false"
              aria-controls="footer-panel-layanan"
              class="flex min-h-11 w-full items-center justify-between gap-3 py-2 text-left md:pointer-events-none md:py-0"
            >
              <span class="type-eyebrow text-white/65">Layanan</span>
              <ChevronDown data-footer-chevron class="h-5 w-5 shrink-0 text-white/60 transition-transform duration-300 md:hidden" />
            </button>
          </h2>
          <div id="footer-panel-layanan" data-footer-panel inert class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 md:grid-rows-[1fr]">
            <div class="overflow-hidden">
              <ul class="type-body-sm space-y-1 pt-1.5 md:mt-3.5 md:pt-0">
                {SERVICE_LINKS.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="inline-flex min-h-9 items-center font-medium text-white/75 transition hover:text-white"
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>

              <div class="mt-4 border-t border-white/10 pt-3 pb-4 md:pb-0">
                <p class="type-eyebrow text-white/65">
                  Nomor Darurat
                </p>
                <p class="type-meta mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 font-medium">
                  <a href={EMERGENCY_NUMBER_LINKS.zurich} class="text-white/70 underline decoration-white/25 underline-offset-4 hover:text-white">
                    Zurich
                  </a>
                  <span aria-hidden="true" class="text-white/30">·</span>
                  <a href={EMERGENCY_NUMBER_LINKS.aca} class="text-white/70 underline decoration-white/25 underline-offset-4 hover:text-white">
                    ACA
                  </a>
                  <span aria-hidden="true" class="text-white/30">·</span>
                  <a href={EMERGENCY_NUMBER_LINKS.gardaOto} class="text-white/70 underline decoration-white/25 underline-offset-4 hover:text-white">
                    Garda Oto
                  </a>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="type-meta mt-10 space-y-2 border-t border-white/10 pt-5 text-white/65">
      <p>
        <a href="/terms-and-privacy" target="_blank" rel="noopener noreferrer" class="font-semibold text-white/85 underline decoration-white/40 underline-offset-4 transition hover:text-white">
          Ketentuan &amp; Privasi
        </a>
      </p>
      <div data-nosnippet class="space-y-2">
        <p>
          AsuransiSerpong.com adalah website pribadi Aditya, Mitra Pemasar PT Mitra Jasa Pratama (Qoala). Website ini bukan website resmi Qoala maupun PT Mitra Jasa Pratama.
        </p>
        <p>
          PT Mitra Jasa Pratama berizin dan diawasi oleh OJK (Nomor Izin KEP-7767/MD/1986). Izin tersebut dimiliki perusahaan, bukan Aditya secara pribadi.
        </p>
        <p>
          Pilihan produk mengikuti perusahaan asuransi rekanan yang tersedia. Ketentuan yang berlaku adalah yang tertulis di dokumen polis resmi. Persetujuan, premi final, dan klaim ditentukan oleh perusahaan asuransi.
        </p>
        <p>© 2026 AsuransiSerpong.com</p>
      </div>
    </div>
  </div>
</footer>

<style>
  [data-footer-acc].open [data-footer-chevron] {
    transform: rotate(180deg);
  }
  [data-footer-acc].open [data-footer-panel] {
    grid-template-rows: 1fr;
  }
  @media (min-width: 48rem) {
    [data-footer-acc] [data-footer-panel] {
      grid-template-rows: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-footer-panel] {
      transition: none;
    }
    [data-footer-chevron] {
      transition: none;
    }
  }
</style>

<script>
  (function () {
    const accs = Array.from(document.querySelectorAll("[data-footer-acc]"));
    if (!accs.length) return;
    const mq = window.matchMedia("(min-width: 48rem)");
    const isDesktop = () => mq.matches;

    function syncAcc(acc: Element, open: boolean) {
      acc.classList.toggle("open", open);
      const toggle = acc.querySelector("[data-footer-toggle]");
      const panel = acc.querySelector("[data-footer-panel]");
      if (toggle) toggle.setAttribute("aria-expanded", String(open || isDesktop()));
      if (panel) {
        // Di desktop panel selalu terekspos ke AT; di mobile ikut state open.
        if (open || isDesktop()) panel.removeAttribute("inert");
        else panel.setAttribute("inert", "");
      }
    }

    function isOpen(acc: Element) {
      return acc.classList.contains("open");
    }

    accs.forEach((acc) => {
      const toggle = acc.querySelector("[data-footer-toggle]");
      if (!toggle) return;
      // Tertutup secara default di mobile (hemat ruang), selalu terbuka di desktop via CSS.
      syncAcc(acc, false);
      toggle.addEventListener("click", () => {
        if (isDesktop()) return;
        syncAcc(acc, !isOpen(acc));
      });
    });

    function syncAll() {
      accs.forEach((acc) => syncAcc(acc, isOpen(acc)));
    }
    mq.addEventListener("change", syncAll);
  })();
</script>
