---
import { RESPONSE_TIME } from "../data/config";
import WaButton from "./WaButton.astro";
import { ArrowDown, Check, CloudRain, Siren } from "lucide-astro";

interface SummaryItem {
  icon: any;
  label: string;
}

interface Props {
  product: string;
  eyebrow: string;
  titleLead: string;
  titleAccent: string;
  lead: string;
  message: string;
  ctaLabel?: string;
  secondaryMessage?: string;
  secondaryLabel?: string;
  priceLine?: string;
  helperLine?: string;
  checks?: string[];
  stackChecks?: boolean;
  background?: "rain" | "property" | "travel";
  note?: { title: string; text: string };
  summary: { icon: any; eyebrow?: string; title: string; items: SummaryItem[]; note?: string };
  secondary?: { href: string; label: string };
  emergency?: { heading: string; items: { href: string; label: string; number: string }[] };
}

const {
  product,
  eyebrow,
  titleLead,
  titleAccent,
  lead,
  message,
  ctaLabel = "Tanya Aditya via WA",
  secondaryMessage,
  secondaryLabel,
  priceLine,
  helperLine,
  checks = ["Konsultasi gratis", "KTP/STNK belum perlu", "Punya foto polisnya? Lampirkan, saya cek isinya."],
  stackChecks = false,
  background = "rain",
  note,
  summary,
  secondary,
  emergency,
} = Astro.props as Props;

const SummaryIcon = summary.icon;
---

<section id="hero" class="relative isolate overflow-hidden bg-ink px-5 pb-10 pt-8 text-white md:pb-16 md:pt-10">
  {background === "rain" ? (
    <div aria-hidden="true" class="rain pointer-events-none -z-10 opacity-40"></div>
  ) : background === "property" ? (
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 overflow-hidden bg-gradient-to-br from-ink via-ink to-ink-2">
      <svg viewBox="0 0 600 500" fill="none" class="absolute -right-24 bottom-0 h-[75%] w-auto max-w-none text-sky-300/10 md:right-0 md:h-full" preserveAspectRatio="xMaxYMax meet">
        <path d="M35 460V255L160 155L285 255V460M85 460V290H235V460M160 155V65L255 125V230M285 460V205L405 120L535 205V460M330 460V235H490V460M35 460H570" stroke="currentColor" stroke-width="2" />
        <path d="M115 325H205V390H115zM360 275H410V330H360zM435 275H465V330H435zM380 460V375H450V460" stroke="currentColor" stroke-width="2" />
      </svg>
    </div>
  ) : (
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 overflow-hidden bg-gradient-to-br from-ink via-ink to-[#102a42]">
      <svg viewBox="0 0 640 420" fill="none" class="absolute right-0 bottom-0 hidden h-full w-[58%] text-sky-300/20 md:block" preserveAspectRatio="xMaxYMax meet">
        <path d="M55 330C160 285 175 165 295 185S430 280 585 85" stroke="currentColor" stroke-width="2" stroke-dasharray="7 10" />
        <circle cx="55" cy="330" r="7" fill="currentColor" />
        <circle cx="585" cy="85" r="7" fill="currentColor" />
        <path d="m350 180 37-5-15-13 4-5 25 15 23-3 7 5-24 8-15 23-6-2 8-17-37 2z" fill="currentColor" />
      </svg>
    </div>
  )}
  <div aria-hidden="true" class="pointer-events-none absolute -top-28 -right-24 -z-10 h-80 w-80 rounded-full bg-sky-400/15 blur-3xl"></div>
  <div class="mx-auto max-w-6xl">
    <nav aria-label="Breadcrumb" class="type-meta text-white/60">
      <a href="/" class="transition hover:text-white">Beranda</a>
      <span class="px-2" aria-hidden="true">/</span>
      <span aria-current="page" class="text-white/85">{product}</span>
    </nav>

    <div class="grid items-center gap-9 pb-8 pt-9 md:grid-cols-[1.1fr_0.9fr] md:gap-14 md:pb-12 md:pt-14">
      <div class="min-w-0">
        <p class="type-eyebrow inline-flex max-w-full items-center gap-2 text-sky-300/95">
          <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-sky-300" aria-hidden="true"></span>
          <span class="min-w-0">{eyebrow}</span>
        </p>
        <h1 class="type-hero mt-4 max-w-3xl">
          {titleLead}{" "}
          <span class="hero-accent text-sky-300">{titleAccent}</span>
        </h1>
        <p class="type-lead mt-5 max-w-[58ch] text-white/75">{lead}</p>

        <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
          <WaButton message={message} class="w-full sm:w-auto md:px-8">{ctaLabel}</WaButton>
          {secondaryMessage && (
            <WaButton message={secondaryMessage} variant="outline" class="w-full sm:w-auto">{secondaryLabel}</WaButton>
          )}
          {secondary && (
            <a
              href={secondary.href}
              class="inline-flex min-h-14 items-center justify-center gap-2 rounded-2xl border border-white/25 px-6 text-[0.9375rem] font-bold text-white transition hover:border-white/60"
            >
              {secondary.label}
              <ArrowDown class="h-4 w-4" />
            </a>
          )}
        </div>
        {priceLine && <p class="type-card-body mt-3 font-semibold text-white/85">{priceLine}</p>}
        {helperLine && <p class="type-meta mt-2 text-white/70">{helperLine}</p>}
        <p class="type-meta mt-2.5 font-medium text-white/65">{RESPONSE_TIME}</p>

        <div class="mt-5 flex items-start gap-3.5">
          <img
            src="/avatar-aditya.jpg"
            alt="Potret Aditya, mitra pemasar asuransi di Serpong"
            width="48"
            height="48"
            class="h-12 w-12 shrink-0 rounded-full object-cover object-[50%_20%] ring-2 ring-wa"
          />
          <ul class:list={["type-meta flex gap-y-1 font-medium text-white/85", stackChecks ? "flex-col" : "flex-wrap gap-x-3.5"]}>
            {checks.map((item) => (
              <li class="flex items-start gap-1.5">
                <Check class="mt-0.5 h-4 w-4 shrink-0 text-wa" stroke-width={2.75} />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        {note && (
          <div class="mt-6 flex gap-3 rounded-2xl border border-amber-300/25 bg-amber-300/10 p-3.5">
            <CloudRain class="mt-0.5 h-5 w-5 shrink-0 text-amber-300" />
            <p class="type-body-sm text-amber-50/90">
              <strong class="font-semibold text-amber-200">{note.title}</strong><br />{note.text}
            </p>
          </div>
        )}
      </div>

      <aside
        class="rounded-[2rem] border border-white/15 bg-white/[0.07] p-5 shadow-2xl shadow-black/20 backdrop-blur-sm md:p-7"
        aria-label={summary.title}
      >
        <div class="flex items-center gap-3">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-wa text-wa-ink">
            <SummaryIcon class="h-6 w-6" />
          </span>
          <div>
            {summary.eyebrow && <p class="type-eyebrow text-white/70">{summary.eyebrow}</p>}
            <h2 class="type-panel-title mt-1">{summary.title}</h2>
          </div>
        </div>
        <div class="mt-5 grid gap-2.5">
          {summary.items.map(({ icon: Icon, label }) => (
            <div class="flex items-center gap-3 rounded-2xl bg-white/[0.06] p-3.5">
              <Icon class="h-5 w-5 shrink-0 text-wa" />
              <span class="type-body-sm font-semibold">{label}</span>
            </div>
          ))}
        </div>
        {summary.note && <p class="type-body-sm mt-4 text-white/70">{summary.note}</p>}
      </aside>
    </div>

    {emergency && (
      <div class="rounded-2xl border border-white/10 bg-white/[0.06] p-4 md:flex md:items-center md:gap-5 md:px-5">
        <div class="type-meta mb-3 flex items-center gap-2 font-semibold text-white/75 md:mb-0 md:min-w-fit">
          <Siren class="h-4 w-4 text-wa" /> {emergency.heading}
        </div>
        <div class="type-meta flex flex-wrap gap-x-4 gap-y-2 font-bold">
          {emergency.items.map((item) => (
            <span class="inline-flex items-center gap-2 text-white">
              {item.label}
              <a href={`tel:${item.number}`} class="text-white/70 underline decoration-white/40 underline-offset-2 transition hover:text-wa focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-wa">{item.number}</a>
              <a href={item.href} class="text-white/70 underline decoration-white/40 underline-offset-2 transition hover:text-wa focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-wa">Info</a>
            </span>
          ))}
        </div>
      </div>
    )}
  </div>
</section>
