---
import type { CollectionEntry } from "astro:content";
import { ArrowUpRight, Clock } from "lucide-astro";
import { blogCategories } from "../data/blog";
import BlogArt from "./BlogArt.astro";

interface Props {
  post: CollectionEntry<"blog">;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { title, excerpt, category, topic, readTime, imagePosition } = post.data;
const label = blogCategories.find(({ id }) => id === category)!.label;
---

<article
  data-blog-card
  data-search={`${title} ${excerpt} ${label} ${topic ?? ""}`.toLocaleLowerCase("id")}
  class:list={["min-w-0", featured && "sm:col-span-2"]}
>
  <a
    href={`/blog/${post.id}`}
    aria-labelledby={`title-${post.id}`}
    class:list={[
      "group grid h-full overflow-hidden rounded-3xl border border-line bg-white transition-colors hover:border-ink/35 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-wa-deep",
      featured ? "lg:grid-cols-[1.05fr_1fr]" : "grid-rows-[auto_1fr]",
    ]}
  >
    <div class:list={["relative overflow-hidden", featured ? "aspect-video sm:aspect-auto sm:h-56 lg:h-auto lg:min-h-70" : "aspect-video"]}>
      <BlogArt
        category={category}
        postId={post.id}
        position={imagePosition ?? "center"}
        sizes={
          featured ? "(min-width: 1024px) 480px, 100vw" : "(min-width: 640px) 384px, 100vw"
        }
      />
      {featured && <span class="type-eyebrow absolute top-4 left-4 rounded-full bg-ink px-3 py-1.5 text-white">Pilihan editor</span>}
    </div>
    <div class:list={["flex flex-col items-start p-5", featured ? "sm:p-8 lg:p-9" : "sm:p-6"]}>
      <p class="type-fine flex flex-wrap items-center gap-x-2 gap-y-1 font-bold text-muted">
        <span class="text-wa-deep">{label}</span>
        {topic && <><span aria-hidden="true">/</span><span>{topic}</span></>}
      </p>
      <h3 id={`title-${post.id}`} class:list={["mt-2 text-pretty group-hover:text-wa-deep", featured ? "type-subsection" : "type-panel-title"]}>
        {title}
      </h3>
      <p class="type-card-body mt-3 mb-5 text-muted">{excerpt}</p>
      <div class="type-meta mt-auto flex w-full items-center justify-between gap-2 border-t border-line pt-3 font-semibold text-muted">
        <span class="inline-flex items-center gap-1.5"><Clock class="size-4" aria-hidden="true" /> {readTime} baca</span>
        <span aria-hidden="true" class="inline-flex items-center gap-1 font-bold text-wa-deep">Baca artikel <ArrowUpRight class="size-4" /></span>
      </div>
    </div>
  </a>
</article>
