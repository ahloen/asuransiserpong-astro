---
import { MESSAGES, RESPONSE_TIME } from "../data/config";
import WaButton from "./WaButton.astro";

interface Props {
  eyebrow?: string;
  title?: string;
  message?: string;
  ctaLabel?: string;
}

const {
  eyebrow,
  title = "Sebelum puncak hujan Desember sampai Februari, cek apakah banjir sudah masuk polis Anda.",
  message = MESSAGES.penutup,
  ctaLabel = "Tanya Aditya via WA",
} = Astro.props as Props;
---

<section class="relative isolate overflow-hidden bg-ink px-5 py-16 text-white md:py-24">
  <div aria-hidden="true" class="rain pointer-events-none -z-10 opacity-45"></div>
  <div aria-hidden="true" class="pointer-events-none absolute -bottom-32 -left-20 -z-10 h-72 w-72 rounded-full bg-sky-400/15 blur-3xl"></div>
  <div class="mx-auto max-w-2xl text-center">
  <img src="/avatar-aditya.jpg" alt="Potret Aditya, mitra pemasar asuransi di Serpong" width="72" height="72" loading="lazy" class="mx-auto mb-5 h-[72px] w-[72px] rounded-full object-cover object-[50%_20%] ring-4 ring-wa/60" />
    {eyebrow && <p class="type-eyebrow text-wa">{eyebrow}</p>}
    <h2 class="type-section mt-3">{title}</h2>
    <WaButton message={message} class="mt-8 w-full md:w-auto md:px-10">{ctaLabel}</WaButton>
    <p class="type-meta mx-auto mt-2.5 max-w-md font-medium text-white/65">{RESPONSE_TIME}</p>
  </div>
</section>
