---
import { getCollection } from "astro:content";
import { ArrowRight, BookOpen, Building2, CarFront, ChevronRight, House, LayoutGrid, Plane, Search, ShieldCheck } from "lucide-astro";
import { blogCategories, type BlogCategory } from "../data/blog";
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogCard from "./BlogCard.astro";
import WaButton from "./WaButton.astro";

interface Props {
  category?: BlogCategory;
}

const { category } = Astro.props;
const active = blogCategories.find(({ id }) => id === category);
const posts = await getCollection("blog", ({ data }) => !category || data.category === category);
posts.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const tabs = [
  { id: undefined, label: "Semua", href: "/blog", Icon: LayoutGrid },
  ...blogCategories.map((item) => ({
    ...item,
    Icon: { mobil: CarFront, travel: Plane, properti: House, bisnis: Building2 }[item.id],
  })),
];
const title = active ? `Panduan ${active.service.label}` : "Asuransi, lebih mudah dipahami.";
const description = active
  ? `Temukan panduan dan tips seputar ${active.service.label.toLowerCase()} dari AsuransiSerpong.`
  : "Panduan praktis seputar asuransi mobil, travel, properti, dan bisnis untuk membantu Anda memilih perlindungan, memahami polis, dan mempersiapkan klaim.";
---

<BaseLayout
  title={active ? `${title} | AsuransiSerpong` : "Artikel & Panduan Asuransi | AsuransiSerpong"}
  description={description}
  showStickyBar={false}
>
  <header class="relative isolate overflow-hidden border-b border-white/10 bg-ink text-white">
    <div class="relative mx-auto max-w-5xl px-5 pt-6 pb-10 sm:pb-14 lg:pb-16">
      <nav aria-label="Jejak navigasi" class="type-fine relative z-10 flex flex-wrap items-center gap-2 font-semibold text-white/70">
        <a href="/" class="hover:text-white hover:underline">Beranda</a>
        <ChevronRight class="size-3.5" aria-hidden="true" />
        {active ? <><a href="/blog" class="hover:text-white hover:underline">Artikel</a><ChevronRight class="size-3.5" aria-hidden="true" /><span aria-current="page" class="text-white">{active.label}</span></> : <span aria-current="page" class="text-white">Artikel</span>}
      </nav>
      <div class="relative z-10 mt-9 max-w-xl sm:mt-12 md:max-w-[35rem]">
        <p class="type-eyebrow inline-flex items-center gap-2 text-wa"><BookOpen class="size-4" aria-hidden="true" /> Panduan AsuransiSerpong</p>
        <h1 class="type-hero mt-4">{title}</h1>
        <p class="type-lead mt-5 max-w-lg text-white/75">{description}</p>
      </div>
      <div aria-hidden="true" class="hero-orbit absolute top-1/2 right-5 hidden size-64 -translate-y-1/2 place-items-center md:grid lg:right-12 lg:size-76">
        <span class="grid size-28 rotate-[-10deg] place-items-center rounded-3xl border border-wa/65 bg-[#d7f3e2] text-ink shadow-[12px_12px_0_#285445] lg:size-32"><ShieldCheck class="size-14" stroke-width={1.4} /></span>
      </div>
    </div>
  </header>

  <section aria-labelledby="blog-heading" class="mx-auto max-w-5xl px-5 pt-8 pb-14 sm:pt-11 sm:pb-20">
    <nav aria-label="Kategori artikel" class="flex flex-wrap gap-2">
      {tabs.map(({ id, label, href, Icon }) => (
        <a href={href} aria-current={id === category ? "page" : undefined} class="type-body-sm inline-flex min-h-11 items-center gap-1.5 rounded-full border border-line bg-white px-3.5 font-bold transition-colors hover:border-ink/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-wa-deep aria-[current=page]:border-ink aria-[current=page]:bg-ink aria-[current=page]:text-white sm:px-4">
          <Icon class="size-4" aria-hidden="true" /> {label}
        </a>
      ))}
    </nav>

    <div class="mt-8 flex flex-col gap-4 border-t border-line pt-6 sm:mt-9 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 id="blog-heading" class="type-subsection">{active ? `Artikel ${active.label}` : "Semua artikel"}</h2>
        <p id="blog-count" role="status" class="type-body-sm mt-1 text-muted">{posts.length} artikel</p>
      </div>
      {posts.length > 0 && (
        <div id="blog-search-wrap" hidden class="relative w-full sm:max-w-xs">
          <Search class="pointer-events-none absolute top-1/2 left-3.5 size-4.5 -translate-y-1/2 text-muted" aria-hidden="true" />
          <input id="blog-search" type="search" aria-label="Cari artikel" placeholder="Cari artikel..." class="min-h-12 w-full rounded-xl border border-line bg-white pr-4 pl-10 text-base outline-none placeholder:text-muted focus:border-wa-deep focus:ring-2 focus:ring-wa-deep/30" />
        </div>
      )}
    </div>

    {posts.length > 0 ? (
      <>
        <div id="blog-grid" class="mt-5 grid gap-5 sm:grid-cols-2">
          {posts.map((post, index) => <BlogCard post={post} featured={!active && index === 0} />)}
        </div>
        <div id="blog-no-results" hidden class="mt-5 rounded-3xl border border-line bg-white px-5 py-9 text-center">
          <p class="type-panel-title">Artikel tidak ditemukan</p>
          <p class="type-card-body mt-2 text-muted">Coba kata kunci lain, misalnya topik atau istilah di polis Anda.</p>
          <button id="blog-clear" type="button" class="type-body-sm mt-3 min-h-11 cursor-pointer font-bold text-wa-deep underline underline-offset-4">Hapus pencarian</button>
        </div>
      </>
    ) : (
      <div class="mt-5 rounded-3xl border border-line bg-white px-5 py-9 text-center sm:p-12">
        <BookOpen class="mx-auto size-7 text-wa-deep" aria-hidden="true" />
        <h3 class="type-panel-title mt-4">{active ? `Belum ada artikel ${active.label}` : "Belum ada artikel"}</h3>
        <p class="type-card-body mt-2 text-muted">{active ? "Sambil menunggu, Anda bisa cek informasi perlindungan di halaman layanan." : "Panduan asuransi akan tampil di sini saat sudah diterbitkan."}</p>
        {active && <a href={active.service.href} class="type-body-sm mt-4 inline-flex min-h-11 items-center gap-2 rounded-full bg-ink px-4 font-bold text-white hover:bg-ink-2">Lihat {active.service.label} <ArrowRight class="size-4" aria-hidden="true" /></a>}
      </div>
    )}

    <aside aria-labelledby="blog-help" class="mt-10 rounded-3xl bg-[#e6ede1] p-6 sm:flex sm:items-center sm:justify-between sm:gap-6 sm:p-8">
      <div>
        <h2 id="blog-help" class="type-panel-title">Masih bingung soal polis atau perlindungan?</h2>
        <p class="type-card-body mt-2 text-muted">Ceritakan kebutuhan Anda. Aditya bantu jelaskan pilihan dan apa yang perlu dicek.</p>
      </div>
      <WaButton message={active ? `Halo Aditya, saya mau bertanya tentang ${active.service.label.toLowerCase()}.` : "Halo Aditya, saya membaca blog AsuransiSerpong dan mau bertanya soal asuransi."} class="mt-4 w-full sm:mt-0 sm:w-auto sm:shrink-0">
        Tanya Aditya via WA
      </WaButton>
    </aside>
  </section>
</BaseLayout>

<style>
  header { background-image: radial-gradient(ellipse at 85% 0%, #173b42, transparent 65%); }
  .hero-orbit {
    border: 1px solid rgb(191 235 211 / 0.22);
    border-radius: 50%;
    background-image: linear-gradient(transparent 49.8%, rgb(191 235 211 / 0.16) 50%, transparent 50.2%), linear-gradient(90deg, transparent 49.8%, rgb(191 235 211 / 0.16) 50%, transparent 50.2%);
    box-shadow: 0 0 0 1.3rem rgb(207 249 229 / 0.04);
  }
  .hero-orbit::before, .hero-orbit::after { content: ""; position: absolute; border-radius: 50%; }
  .hero-orbit::before { inset: 13%; border: 1px dashed rgb(191 235 211 / 0.3); }
  .hero-orbit::after { top: 17%; right: 12%; width: 0.65rem; height: 0.65rem; background: var(--color-wa); }
</style>

<script>
  const search = document.querySelector<HTMLInputElement>("#blog-search");
  const searchWrap = document.getElementById("blog-search-wrap");
  const cards = document.querySelectorAll<HTMLElement>("#blog-grid [data-blog-card]");
  const count = document.getElementById("blog-count");
  const empty = document.getElementById("blog-no-results");

  if (search && searchWrap && count && empty) {
    const updateResults = () => {
      const terms = search.value.toLocaleLowerCase("id").trim().split(/\s+/).filter(Boolean);
      let matches = 0;
      for (const card of cards) {
        const text = card.dataset.search ?? "";
        card.hidden = !terms.every((term) => text.includes(term));
        if (!card.hidden) matches++;
      }
      const label = `${matches} artikel${terms.length ? " ditemukan" : ""}`;
      if (count.textContent !== label) count.textContent = label;
      empty.hidden = matches !== 0;
    };
    search.addEventListener("input", updateResults);
    window.addEventListener("pageshow", updateResults);
    document.getElementById("blog-clear")?.addEventListener("click", () => {
      search.value = "";
      search.focus();
      updateResults();
    });
    updateResults();
    searchWrap.hidden = false;
  }
</script>
