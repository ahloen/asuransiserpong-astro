---
import { MESSAGES, RESPONSE_TIME } from "../data/config";
import WaButton from "./WaButton.astro";
import { Check, CloudRain } from "lucide-astro";

const wave = "M0 8 q45 -10 90 0 t90 0 t90 0 t90 0 t90 0 t90 0 t90 0 t90 0 V80 H0 Z";
---

<section id="hero" class="relative isolate overflow-hidden bg-ink text-white">
  <div aria-hidden="true" class="rain pointer-events-none -z-10 opacity-75"></div>
  <div aria-hidden="true" class="pointer-events-none absolute -top-28 -right-24 -z-10 h-80 w-80 rounded-full bg-sky-400/15 blur-3xl"></div>
  <div class="mx-auto grid max-w-5xl gap-5 px-5 pt-7 md:grid-cols-[1.2fr_0.8fr] md:items-end md:gap-8 md:pt-16">
    <div class="min-w-0 md:pb-14">
      <p class="inline-flex max-w-full items-center gap-2 text-xs leading-relaxed font-semibold tracking-[0.08em] text-sky-300/95 uppercase">
        <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-sky-300" aria-hidden="true"></span>
        <span class="min-w-0">Asuransi mobil &amp; rumah · BSD · Gading Serpong · Alam Sutera</span>
      </p>
      <h1 class="mt-3.5 font-display text-[2.125rem] leading-[1.12] font-bold tracking-[-0.03em] text-balance sm:text-[2.625rem] lg:text-[3.375rem]">
        Polis mobil mau habis? Tanya dulu{" "}
        <span class="hero-accent text-sky-300">soal banjirnya.</span>
      </h1>
      <p class="mt-5 max-w-[58ch] text-[1.0625rem] leading-relaxed text-pretty text-white/80">
        Polis All Risk belum tentu menjamin banjir. Kirim foto ikhtisar polis; saya bantu cek jaminan banjir, biaya sendiri, dan masa berlakunya sebelum Anda memperpanjang.
      </p>
      <WaButton message={MESSAGES.banjir} class="mt-6 w-full md:w-auto md:px-8">Tanya Aditya via WA</WaButton>
      <p class="mt-2.5 text-[0.8125rem] font-medium text-white/65">{RESPONSE_TIME}</p>
      <div class="mt-5 flex items-center gap-3.5">
        <img src="/avatar-aditya.jpg" alt="Potret Aditya, mitra pemasar asuransi di Serpong" width="48" height="48" class="h-12 w-12 shrink-0 rounded-full object-cover object-[50%_20%] ring-2 ring-wa" />
        <ul class="flex flex-wrap gap-x-3.5 gap-y-1 text-[0.8125rem] font-medium text-white/85">
          {["Konsultasi gratis", "KTP/STNK belum perlu", "Punya foto polisnya? Lampirkan, saya cek isinya."].map((t) => (
            <li class="flex items-start gap-1.5"><Check class="mt-0.5 h-4 w-4 shrink-0 text-wa" stroke-width={2.75} /><span>{t}</span></li>
          ))}
        </ul>
      </div>
      
      <div class="mt-6 flex gap-3 rounded-2xl border border-amber-300/25 bg-amber-300/10 p-3.5">
        <CloudRain class="mt-0.5 h-5 w-5 shrink-0 text-amber-300" />
        <p class="text-[0.875rem] leading-[1.5] text-amber-50/90">
          <strong class="font-semibold text-amber-200">Cek sebelum memilih atau memperpanjang.</strong><br />Pastikan risiko banjir dan biaya sendiri tercantum sesuai kebutuhan Anda.
        </p>
      </div>
    </div>
    <div class="-mx-5 mt-1 md:mx-0 md:mt-0">
      <div class="relative">
        <div class="absolute top-2 left-5 z-10 flex items-center gap-2 rounded-full border border-amber-300/35 bg-ink/75 py-1.5 pr-3.5 pl-2 text-xs font-semibold text-amber-200 backdrop-blur">
          <span class="grid h-5 w-5 place-items-center rounded-full bg-amber-300 text-[0.75rem] font-bold text-ink">?</span>
          Banjir ikut dijamin?
        </div>
        <svg viewBox="0 0 360 170" class="block h-auto w-full" role="img" aria-label="Ilustrasi mobil terendam banjir">
          <defs>
            <linearGradient id="water" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#3aa6d9" stop-opacity="0.85" />
              <stop offset="1" stop-color="#14507a" stop-opacity="0.95" />
            </linearGradient>
            <linearGradient id="body" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#4a7497" />
              <stop offset="1" stop-color="#2b4d6b" />
            </linearGradient>
          </defs>
          <g transform="translate(0 100)" opacity="0.55">
            <g class="wave-b"><path d={wave} fill="#2c86b8" /></g>
          </g>
          <g transform="translate(0 12)">
            <path d="M34 104 L34 88 Q34 80 44 78 L78 72 L100 50 Q104 46 110 46 L214 46 Q222 46 228 52 L252 76 L300 82 Q316 84 316 96 L316 104 Z" fill="url(#body)" stroke="#6f9bc0" stroke-width="1.2" />
            <path d="M104 56 L150 56 L150 74 L88 74 Z" fill="#0d2336" opacity="0.92" />
            <path d="M156 56 L214 56 L232 74 L156 74 Z" fill="#0d2336" opacity="0.92" />
            <path d="M104 56 L118 56 L100 74 L88 74 Z" fill="#fff" opacity="0.08" />
            <path d="M156 56 L170 56 L170 74 L156 74 Z" fill="#fff" opacity="0.06" />
            <rect x="34" y="84" width="7" height="9" rx="2" fill="#ef4444" />
            <rect x="306" y="88" width="10" height="8" rx="2.5" fill="#fcd34d" />
            <path d="M150 80 H168" stroke="#9cc2e0" stroke-width="2" stroke-linecap="round" opacity="0.7" />
            <g>
              <circle cx="92" cy="106" r="17" fill="#07121d" /><circle cx="92" cy="106" r="8" fill="#6b8ca8" /><circle cx="92" cy="106" r="3" fill="#07121d" />
              <circle cx="262" cy="106" r="17" fill="#07121d" /><circle cx="262" cy="106" r="8" fill="#6b8ca8" /><circle cx="262" cy="106" r="3" fill="#07121d" />
            </g>
          </g>
          <g transform="translate(0 104)">
            <g class="wave-a"><path d={wave} fill="url(#water)" /></g>
          </g>
        </svg>
      </div>
    </div>
  </div>
</section>
