---
import { getCollection } from "astro:content";
import { blogCategories } from "../data/blog";
import { ArrowLeft, ArrowRight, BadgeDollarSign, Camera, CarFront, Clock, CloudRain, RefreshCw, Wrench } from "lucide-astro";

const posts = await getCollection("blog");
posts.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const visualMap: Record<string, { icon: any; cls: string }> = {
  "banjir-tidak-selalu-dijamin": { icon: CloudRain, cls: "from-sky-100 via-sky-50 to-cyan-100 text-sky-800" },
  "all-risk-vs-tlo": { icon: CarFront, cls: "from-emerald-100 via-teal-50 to-cyan-100 text-emerald-800" },
  "biaya-sendiri-yang-sering-lupa": { icon: BadgeDollarSign, cls: "from-amber-100 via-orange-50 to-yellow-100 text-amber-800" },
  "bengkel-rekanan-berubah": { icon: Wrench, cls: "from-violet-100 via-indigo-50 to-sky-100 text-violet-800" },
  "perpanjangan-tidak-selalu-sama": { icon: RefreshCw, cls: "from-rose-100 via-orange-50 to-amber-100 text-rose-800" },
  "cara-klaim-tanpa-panik": { icon: Camera, cls: "from-slate-200 via-sky-50 to-slate-100 text-slate-800" },
};
const fallback = visualMap["banjir-tidak-selalu-dijamin"];
---

<section
  id="blog"
  aria-labelledby="tips-title"
  class="overflow-hidden bg-paper py-14 md:py-20"
>
  <div class="mx-auto max-w-5xl">
    <div class="flex items-end justify-between gap-5 px-5">
      <div>
        <p class="inline-flex items-center gap-2 text-[0.75rem] font-semibold tracking-[0.1em] text-wa-deep uppercase">
          <span class="h-1.5 w-1.5 rounded-full bg-wa-deep" aria-hidden="true"></span>
          Blog
        </p>
        <h2
          id="tips-title"
          class="mt-2.5 font-display text-[1.625rem] leading-[1.18] font-bold tracking-[-0.025em] text-balance md:text-[2.125rem] md:leading-[1.14]"
        >
          Artikel terbaru
        </h2>
        <p class="mt-2 max-w-sm text-[0.9375rem] leading-[1.6] text-muted">
          Penjelasan singkat soal polis, klaim, dan perpanjangan.
        </p>
      </div>
      <div class="hidden shrink-0 gap-2 md:flex">
        <button
          type="button"
          id="tips-prev"
          aria-label="Artikel sebelumnya"
          class="grid h-11 w-11 place-items-center rounded-full border border-line bg-white text-ink transition hover:border-ink/30 disabled:cursor-not-allowed disabled:opacity-35"
        >
          <ArrowLeft class="h-5 w-5" />
        </button>
        <button
          type="button"
          id="tips-next"
          aria-label="Artikel berikutnya"
          class="grid h-11 w-11 place-items-center rounded-full border border-line bg-white text-ink transition hover:border-ink/30 disabled:cursor-not-allowed disabled:opacity-35"
        >
          <ArrowRight class="h-5 w-5" />
        </button>
      </div>
    </div>

    <div
      id="tips-track"
      role="region"
      aria-roledescription="carousel"
      aria-label="Artikel Tips dan Informasi"
      tabindex="0"
      class="tips-carousel mt-7 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-3 outline-none focus-visible:ring-2 focus-visible:ring-wa-deep focus-visible:ring-offset-4 md:gap-5"
    >
      {posts.map((post, index) => {
        const visual = visualMap[post.id] ?? fallback;
        const Icon = visual.icon;
        return (
          <article
            data-article-card
            aria-label={`${index + 1} dari ${posts.length}`}
            class="w-[calc(100vw-3.75rem)] max-w-[21rem] shrink-0 snap-start sm:w-[20rem] md:w-[21rem]"
          >
            <a
              href={`/blog/${post.id}`}
              class="group block rounded-3xl outline-none focus-visible:ring-2 focus-visible:ring-wa-deep focus-visible:ring-offset-4"
            >
              <div class={`relative flex h-44 items-center justify-center overflow-hidden rounded-3xl bg-gradient-to-br ${visual.cls}`}>
                <span class="absolute top-4 left-4 rounded-full bg-white/85 px-3 py-1.5 text-[0.75rem] font-bold text-ink shadow-sm">
                  {post.data.topic ?? blogCategories.find(({ id }) => id === post.data.category)?.label}
                </span>
                <div class="absolute -right-8 -bottom-10 h-36 w-36 rounded-full bg-white/30 blur-2xl" aria-hidden="true"></div>
                <span class="grid h-24 w-24 place-items-center rounded-[2rem] border border-white/60 bg-white/45 shadow-lg shadow-ink/5 backdrop-blur-sm transition-transform duration-300 group-hover:-translate-y-1">
                  <Icon class="h-12 w-12" stroke-width={1.55} />
                </span>
              </div>
              <h3 class="mt-4 min-h-[3lh] font-display text-[1.125rem] leading-[1.4] font-bold tracking-[-0.02em] text-balance wrap-anywhere transition-colors group-hover:text-wa-deep">
                {post.data.title}
              </h3>
              <span class="mt-2 inline-flex items-center gap-1.5 text-[0.8125rem] font-medium text-muted">
                <Clock class="h-4 w-4" />
                {post.data.readTime} baca
              </span>
            </a>
          </article>
        );
      })}
      <div aria-hidden="true" class="w-[calc(100%-22.5rem)] shrink-0"></div>
    </div>

    <div class="mt-4 flex flex-wrap items-center justify-between gap-x-4 gap-y-1 px-5">
      <div class="flex items-center gap-2.5" aria-label="Pilih artikel">
        {posts.map((post, index) => (
          <button
            type="button"
            data-tips-dot={index}
            aria-label={`Buka artikel ${index + 1}: ${post.data.title}`}
            class="group grid h-9 w-5 place-items-center"
          >
            <span
              data-tips-dot-inner={index}
              class={`block rounded-full transition-all duration-300 ${index === 0 ? "h-2.5 w-2.5 bg-wa-deep ring-4 ring-wa/20" : "h-2 w-2 border-[1.5px] border-ink/45 group-hover:border-wa-deep"}`}
            ></span>
          </button>
        ))}
      </div>
      <a
        href="/blog"
        class="inline-flex min-h-10 shrink-0 items-center gap-1.5 text-[0.875rem] font-bold text-wa-deep underline decoration-wa-deep/30 underline-offset-4 hover:decoration-wa-deep"
      >
        Semua artikel
        <ArrowRight class="h-4 w-4" />
      </a>
    </div>
  </div>
</section>

<script>
  (function () {
    const track = document.getElementById("tips-track")!;
    if (!track) return;
    const prev = document.getElementById("tips-prev") as HTMLButtonElement | null;
    const next = document.getElementById("tips-next") as HTMLButtonElement | null;
    const total = track.querySelectorAll("[data-article-card]").length;
    let active = 0;
    function paint() {
      for (let i = 0; i < total; i++) {
        const inner = document.querySelector('[data-tips-dot-inner="' + i + '"]');
        if (!inner) continue;
        const on = i === active;
        inner.className = "block rounded-full transition-all duration-300 " + (on
          ? "h-2.5 w-2.5 bg-wa-deep ring-4 ring-wa/20"
          : "h-2 w-2 border-[1.5px] border-ink/45 group-hover:border-wa-deep");
        const dot = document.querySelector('[data-tips-dot="' + i + '"]');
        if (dot) {
          if (on) dot.setAttribute("aria-current", "true");
          else dot.removeAttribute("aria-current");
        }
      }
      if (prev) prev.disabled = active === 0;
      if (next) next.disabled = active === total - 1;
    }
    function goTo(index: number) {
      const nextIdx = Math.max(0, Math.min(index, total - 1));
      const card = track.querySelectorAll<HTMLElement>("[data-article-card]")[nextIdx];
      if (!card) return;
      track.scrollTo({
        left: card.offsetLeft - track.offsetLeft,
        behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
      });
      active = nextIdx;
      paint();
    }
    let frame = 0;
    let touchStartX = 0;
    let touchStartY = 0;
    let touchStartScrollLeft = 0;
    let horizontalSwipe = false;
    function updateActive() {
      const cards = Array.from(track.querySelectorAll<HTMLElement>("[data-article-card]"));
      if (!cards.length) return;
      let nearest = 0;
      let distance = Number.POSITIVE_INFINITY;
      cards.forEach(function (card, index) {
        const d = Math.abs(card.offsetLeft - track.scrollLeft - track.offsetLeft);
        if (d < distance) { distance = d; nearest = index; }
      });
      active = nearest;
      paint();
    }
    function onScroll() {
      if (frame) return;
      frame = requestAnimationFrame(function () { updateActive(); frame = 0; });
    }
    updateActive();
    track.addEventListener("scroll", onScroll, { passive: true });
    track.addEventListener("touchstart", function (e) {
      const touch = e.touches[0];
      if (!touch) return;
      touchStartX = touch.clientX;
      touchStartY = touch.clientY;
      touchStartScrollLeft = track.scrollLeft;
      horizontalSwipe = false;
    }, { passive: true });
    track.addEventListener("touchmove", function (e) {
      const touch = e.touches[0];
      if (!touch) return;
      const dx = touch.clientX - touchStartX;
      const dy = touch.clientY - touchStartY;
      if (!horizontalSwipe && Math.abs(dx) > 8 && Math.abs(dx) > Math.abs(dy)) horizontalSwipe = true;
      if (!horizontalSwipe) return;
      e.preventDefault();
      track.scrollLeft = touchStartScrollLeft - dx;
    }, { passive: false });
    window.addEventListener("resize", onScroll);
    if (prev) prev.addEventListener("click", function () { goTo(active - 1); });
    if (next) next.addEventListener("click", function () { goTo(active + 1); });
    document.querySelectorAll("[data-tips-dot]").forEach(function (dot) {
      dot.addEventListener("click", function () { goTo(Number(dot.getAttribute("data-tips-dot"))); });
    });
    track.addEventListener("keydown", function (e) {
      if (e.key === "ArrowRight") { e.preventDefault(); goTo(active + 1); }
      else if (e.key === "ArrowLeft") { e.preventDefault(); goTo(active - 1); }
    });
  })();
</script>
