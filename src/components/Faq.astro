---
import { MESSAGES, waLink } from "../data/config";
import { ChevronDown } from "lucide-astro";
import { homeFaqs as faqs } from "../data/home-faqs";
---

<section id="faq" class="bg-white px-5 py-14 md:py-20">
  <div class="mx-auto max-w-3xl">
    <p class="inline-flex items-center gap-2 text-[0.75rem] font-semibold tracking-[0.1em] text-wa-deep uppercase">
      <span class="h-1.5 w-1.5 rounded-full bg-wa-deep" aria-hidden="true"></span>
      FAQ
    </p>
    <h2 class="mt-2.5 font-display text-[1.625rem] leading-[1.18] font-bold tracking-[-0.025em] text-balance md:text-[2.125rem] md:leading-[1.14]">
      Pertanyaan yang paling sering muncul
    </h2>

    <div class="mt-7 divide-y divide-line overflow-hidden rounded-3xl border border-line bg-paper">
      {faqs.map((f, i) => (
        <div>
          <h3>
            <button
              type="button"
              data-faq-toggle={i}
              id={`faq-q-${i}`}
              aria-expanded={i === 0 ? "true" : "false"}
              aria-controls={`faq-a-${i}`}
              class="flex min-h-16 w-full items-center justify-between gap-4 px-5 py-4 text-left text-[1rem] leading-[1.4] font-semibold tracking-[-0.01em]"
            >
              {f.question}
              <span data-faq-badge={i} class={`grid h-8 w-8 shrink-0 place-items-center rounded-full transition-colors duration-300 ${i === 0 ? "bg-ink text-white" : "bg-white text-ink"}`}>
                <ChevronDown data-faq-chevron={i} class={`h-4 w-4 transition-transform duration-300 ${i === 0 ? "rotate-180" : ""}`} />
              </span>
            </button>
          </h3>
          <div
            id={`faq-a-${i}`}
            role="region"
            aria-labelledby={`faq-q-${i}`}
            data-faq-panel={i}
            class={`grid transition-[grid-template-rows] duration-300 ${i === 0 ? "grid-rows-[1fr]" : "grid-rows-[0fr]"}`}
          >
            <div class="overflow-hidden">
              <p class="px-5 pb-5 text-[0.9375rem] leading-[1.65] text-muted">{f.answer}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <p class="mt-6 text-center text-[0.9375rem] text-muted">
      Pertanyaan Anda belum ada?{" "}
      <a
        href={waLink(MESSAGES.faq)}
        data-wa-message={MESSAGES.faq}
        target="_blank"
        rel="noopener noreferrer"
        class="font-bold text-wa-deep underline decoration-wa-deep/40 underline-offset-4 hover:decoration-wa-deep"
      >
        Tanya langsung via WA
      </a>
    </p>
  </div>
</section>

<script>
  (function () {
    const buttons = Array.from(document.querySelectorAll("[data-faq-toggle]"));
    function setOpen(idx: number) {
      buttons.forEach(function (btn) {
        var i = btn.getAttribute("data-faq-toggle");
        var panel = document.querySelector('[data-faq-panel="' + i + '"]');
        var badge = document.querySelector('[data-faq-badge="' + i + '"]');
        var chevron = document.querySelector('[data-faq-chevron="' + i + '"]');
        var isOpen = i === String(idx);
        btn.setAttribute("aria-expanded", String(isOpen));
        if (panel) {
          panel.classList.toggle("grid-rows-[1fr]", isOpen);
          panel.classList.toggle("grid-rows-[0fr]", !isOpen);
        }
        if (badge) {
          badge.classList.toggle("bg-ink", isOpen);
          badge.classList.toggle("text-white", isOpen);
          badge.classList.toggle("bg-white", !isOpen);
          badge.classList.toggle("text-ink", !isOpen);
        }
        if (chevron) chevron.classList.toggle("rotate-180", isOpen);
      });
    }
    let current = 0;
    setOpen(0);
    buttons.forEach(function (btn) {
      btn.addEventListener("click", function () {
        const i = Number(btn.getAttribute("data-faq-toggle"));
        current = current === i ? -1 : i;
        setOpen(current);
      });
    });
  })();
</script>
